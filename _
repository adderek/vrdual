#!/usr/bin/env bash
# vrdual — human front end. Bare `_` = help + interactive menu.
# Implementation lives here; `vrdual` sources this file for the machine contract.
set -euo pipefail
VRDUAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
B="$VRDUAL_ROOT/build"

say() { printf '%s\n' "$*" >&2; }

# ---------------------------------------------------------------- commands --
vrdual_build() { make -C "$VRDUAL_ROOT" -j"$(nproc)" all lib32 >&2; }

# Lists display-class PCI GPUs and the narrowest link on the path to the CPU
# (the GPU's own slot always claims x16; the chipset uplink is what limits).
vrdual_gpus() {
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [[ "$(cat "$dev/class")" == 0x03* ]] || continue
        local bdf path n minw=99 mins=99 node chipset=0
        bdf=$(basename "$dev")
        path=$(realpath "$dev")
        n=0
        for node in $(echo "${path#/sys/devices/}" | tr / ' '); do
            [[ $node == pci* ]] && continue
            local p=/sys/bus/pci/devices/$node w s
            [[ -r $p/max_link_width ]] || continue
            w=$(cat "$p/max_link_width"); s=$(cut -d' ' -f1 "$p/max_link_speed")
            (( w < minw )) && minw=$w
            awk "BEGIN{exit !($s < $mins)}" && mins=$s
            n=$((n + 1))
        done
        # >2 bridge hops between root complex and GPU = behind a switch (chipset on AM4/AM5).
        (( n > 4 )) && chipset=1
        printf '%s\t%s\tGen-speed=%sGT/s\tx%s\tbridges=%s\t%s\n' "$bdf" \
            "$(lspci -s "$bdf" | cut -d: -f3- | sed 's/^ //' | cut -c1-60)" "$mins" "$minw" "$n" \
            "$( ((chipset)) && echo 'behind-switch(chipset?)' || echo 'cpu-direct')"
    done
}

vrdual_clean() { rm -f /dev/shm/vrdual-* "$FLATPAK_SHM"/vrdual-* 2>/dev/null; say "removed vrdual-* from /dev/shm (and Flatpak Steam's)"; }

# vrdual_run [--left-gpu G] [--right-gpu G] [--session S] [--snapshot PNG --at N] -- APP ARGS...
# Starts the compositor and two copies of APP (one per eye/GPU). All VRDUAL_*
# variables in the environment (IPD, ANCHOR, ...) are passed through.
vrdual_run() {
    local lg="" rg=""  # empty = left_gpu/right_gpu from the config file
    local session="${VRDUAL_SESSION:-default}" snapshot="" at=120 scale="${VRDUAL_SCALE:-1}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --left-gpu) lg=$2; shift 2 ;;
            --right-gpu) rg=$2; shift 2 ;;
            --session) session=$2; shift 2 ;;
            --snapshot) snapshot=$2; shift 2 ;;
            --at) at=$2; shift 2 ;;
            --scale) scale=$2; shift 2 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    [[ $# -gt 0 ]] || { say "run: missing app command"; return 2; }
    [[ -x $B/libVkLayer_vrdual.so || -f $B/libVkLayer_vrdual.so ]] || vrdual_build
    rm -f /dev/shm/vrdual-"$session"-*
    local -a envs=(VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION="$session")
    local pids=()
    env "${envs[@]}" VRDUAL_EYE=left ${lg:+VRDUAL_GPU="$lg"} "$@" >&2 & pids+=($!)
    env "${envs[@]}" VRDUAL_EYE=right ${rg:+VRDUAL_GPU="$rg"} "$@" >&2 & pids+=($!)
    local rc=0
    if [[ -n $snapshot ]]; then
        "$B/vrdual-compositor" --session "$session" --snapshot "$snapshot" --at "$at" || rc=$?
        kill "${pids[@]}" 2>/dev/null || true
        echo "$snapshot"
    else
        "$B/vrdual-compositor" --session "$session" --scale "$scale" || rc=$?
        kill "${pids[@]}" 2>/dev/null || true
    fi
    wait 2>/dev/null || true
    rm -f /dev/shm/vrdual-"$session"-*
    return $rc
}

vrdual_demo() { vrdual_run "$@" -- "$B/vrdual-cube"; }

# Calibration: static posts at 0.5/1/2/5/20 m, compositor keys change IPD live.
vrdual_calib() { vrdual_run "$@" -- "$B/vrdual-cube" --scene calib; }

# Config file + live control of a running session (thin wrappers on vrdual-ctl).
vrdual_config() { "$B/vrdual-ctl" "${1:-show}" "${@:2}"; }
vrdual_live() { pick_shm "$@"; "$B/vrdual-ctl" live "$@"; }
vrdual_set() { pick_shm "$@"; "$B/vrdual-ctl" set "$@"; }
vrdual_save() { pick_shm "$@"; "$B/vrdual-ctl" save "$@"; }

# ------------------------------------------------------------ steam / HMD --
STEAM_FLATPAK="$HOME/.var/app/com.valvesoftware.Steam"
FLATPAK_SHM="/run/user/$(id -u)/.flatpak/com.valvesoftware.Steam/dev-shm"

# Frame files and control block of a game inside Flatpak Steam live in its
# private /dev/shm. Exports VRDUAL_SHM_DIR when that is where session S is
# (or will be: Flatpak Steam runs and /dev/shm has nothing for S).
pick_shm() {
    [[ -n ${VRDUAL_SHM_DIR:-} ]] && return 0
    local s="${VRDUAL_SESSION:-default}" a
    for a in "$@"; do [[ ${prev:-} == --session ]] && s=$a; prev=$a; done
    unset prev
    if [[ ! -e /dev/shm/vrdual-$s-ctl && -d $FLATPAK_SHM/ ]]; then
        export VRDUAL_SHM_DIR=$FLATPAK_SHM
        say "session '$s': using Flatpak Steam's /dev/shm ($FLATPAK_SHM)"
    fi
}

# Installs the layer (32 + 64 bit) and a launch wrapper where Steam games can
# see them; prints the Steam launch option (stdout).
vrdual_steam_install() {
    make -C "$VRDUAL_ROOT" -j"$(nproc)" all lib32 >&2 || return 1
    local host inside
    if [[ -d $STEAM_FLATPAK ]]; then
        host=$STEAM_FLATPAK/vrdual; inside=$HOME/vrdual
    else
        host=$HOME/.local/share/vrdual; inside=$host
    fi
    mkdir -p "$host/layer"
    cp "$B/libVkLayer_vrdual.so" "$host/layer/libVkLayer_vrdual64.so"
    cp "$B/lib32/libVkLayer_vrdual.so" "$host/layer/libVkLayer_vrdual32.so"
    local bits
    for bits in 32 64; do
        sed -e "s|\"./libVkLayer_vrdual.so\"|\"./libVkLayer_vrdual$bits.so\",\n        \"library_arch\": \"$bits\"|" \
            -e 's|"file_format_version": "1.2.0"|"file_format_version": "1.2.1"|' \
            "$VRDUAL_ROOT/layer/VkLayer_vrdual.json.in" >"$host/layer/VkLayer_vrdual$bits.json"
    done
    cat >"$host/run" <<'WRAP'
#!/bin/sh
# vrdual Steam wrapper (installed by `vrdual steam-install`).
# Steam > game > Properties > Launch options:   <path of this file> %command%
# One process, the game sees one GPU, the other renders the second eye.
# OpenGL games go through Zink (GL on Vulkan) so the layer can see them.
d=$(dirname "$(readlink -f "$0")")
export VK_ADD_LAYER_PATH="$d/layer${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"
export VK_INSTANCE_LAYERS="VK_LAYER_VRDUAL_stereo${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}"
export VRDUAL_EYE="${VRDUAL_EYE:-both}"
export MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-zink}"
# glvnd would pick NVIDIA's own GL (bypasses Vulkan and the layer); force Mesa.
export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-mesa}"
# Host config copy (steam-install); Proton games log to ~/.var/app/…Steam/steam-<appid>.log
[ -f "$d/vrdual.conf" ] && export VRDUAL_CONFIG="${VRDUAL_CONFIG:-$d/vrdual.conf}"
export PROTON_LOG="${PROTON_LOG:-1}"
# native games (no Proton): stderr incl. the layer log -> game.log next to this
case "$*" in *proton*) exec "$@" ;; *) exec "$@" 2>"$d/game.log" ;; esac
WRAP
    chmod +x "$host/run"
    if [[ -f $(vrdual-config-path) ]]; then
        cp "$(vrdual-config-path)" "$host/vrdual.conf"
        say "copied $(vrdual-config-path) -> $host/vrdual.conf (the game reads that one)"
    else
        rm -f "$host/vrdual.conf"
    fi
    say "installed to $host"
    say "Steam > game > Properties > Launch options:"
    echo "$inside/run %command%"
}
vrdual-config-path() { "$B/vrdual-ctl" path; }

# Warns when the layer or config copy Steam games load differs from build/ or
# the host config (forgot `vrdual steam-install`: the game runs the old one).
steam_layer_check() {
    local d c
    c=$(vrdual-config-path)
    for d in "$STEAM_FLATPAK/vrdual" "$HOME/.local/share/vrdual"; do
        [[ -f $d/layer/libVkLayer_vrdual64.so ]] || continue
        cmp -s "$d/layer/libVkLayer_vrdual64.so" "$B/libVkLayer_vrdual.so" || say "warning: $d/layer differs from build/ (run: vrdual steam-install)"
        if [[ -f $c ]] && ! cmp -s "$c" "$d/vrdual.conf"; then say "warning: $d/vrdual.conf differs from $c (run: vrdual steam-install)"; fi
    done
    return 0
}

# Build identity (tools/build_info.sh) of what would run: source tree, tools,
# build/ layers and the copies games load (steam-install). stdout = data:
# "<what>\t<build info>", "-" when missing.
vrdual_version() {
    local f d i
    printf 'source\t%s\n' "$("$VRDUAL_ROOT/tools/build_info.sh" | sed 's/, built .*//') (now)"
    printf 'tools\t%s\n' "$("$B/vrdual-ctl" --version 2>/dev/null || echo -)"
    for f in "$B/libVkLayer_vrdual.so" "$B/lib32/libVkLayer_vrdual.so" \
        "$STEAM_FLATPAK"/vrdual/layer/libVkLayer_vrdual{64,32}.so "$HOME"/.local/share/vrdual/layer/libVkLayer_vrdual{64,32}.so; do
        d=${f/#$HOME/\~}
        [[ -f $f ]] || { [[ $f == "$B"/* ]] && printf '%s\t-\n' "$d"; continue; }
        printf '%s\t%s\n' "$d" "$(layer_info "$f")"
    done
}

layer_info() {
    local i
    i=$(strings -a "$1" | grep -m1 '^vrdual .*, built ' || true)  # grep -m1: SIGPIPE for strings, pipefail
    echo "${i:-(older than build info)}"
}

# SBS window for a running session (also finds games inside Flatpak Steam).
vrdual_view() { pick_shm "$@"; "$B/vrdual-compositor" "$@"; }

# HMD output through OpenXR. Without an active runtime, uses WiVRn's Flatpak.
# WiVRn as runtime needs wivrn-server: started in the background when none
# runs (log: $XDG_RUNTIME_DIR/vrdual-wivrn.log); --no-start-wivrn refuses instead,
# --restart-wivrn stops a running one first (headset stuck on WiVRn's app list).
# Audio follows the headset (xr_audio_follow); --no-audio leaves outputs alone.
vrdual_xr() {
    local a start=1 restart=0 audio=1 args=()
    for a in "$@"; do
        case $a in --no-start-wivrn) start=0 ;; --restart-wivrn) restart=1 ;; --no-audio) audio=0 ;; *) args+=("$a") ;; esac
    done
    set -- "${args[@]}"
    # follows the game between host /dev/shm and Flatpak Steam's, across games
    if [[ -z ${VRDUAL_SHM_DIR:-} && -d $STEAM_FLATPAK ]]; then export VRDUAL_SHM_DIR="/dev/shm:$FLATPAK_SHM"; fi
    steam_layer_check
    if [[ -z ${XR_RUNTIME_JSON:-} && ! -e ${XDG_CONFIG_HOME:-$HOME/.config}/openxr/1/active_runtime.json ]]; then
        local w
        w=$(flatpak info --show-location io.github.wivrn.wivrn 2>/dev/null) && export XR_RUNTIME_JSON=$w/files/share/openxr/1/openxr_wivrn.json
    fi
    local rt=${XR_RUNTIME_JSON:-$(readlink -f "${XDG_CONFIG_HOME:-$HOME/.config}/openxr/1/active_runtime.json" 2>/dev/null)}
    if [[ $rt == *wivrn* ]] && ((restart)); then
        vrdual_wivrn-restart || return 1
    elif [[ $rt == *wivrn* ]] && ! pgrep -x wivrn-server >/dev/null; then
        if ((!start)); then
            say "error: wivrn-server is not running. Start it first: 'vrdual wivrn' in another terminal, or drop --no-start-wivrn"
            return 1
        fi
        wivrn_bg_start || return 1
    fi
    if [[ $rt == *wivrn* ]] && ((audio)) && command -v pactl >/dev/null; then
        local state rc=0 ap
        state=$(mktemp)
        xr_audio_follow "$state" & ap=$!
        trap ':' INT TERM  # Ctrl-C ends vrdual-xr; the restore below still runs
        "$B/vrdual-xr" "$@" || rc=$?
        trap - INT TERM
        kill $ap 2>/dev/null || true
        wait $ap 2>/dev/null || true  # killed: 143, and set -e
        xr_audio_restore "$state"
        rm -f "$state"
        return $rc
    fi
    "$B/vrdual-xr" "$@"
}

# Game audio to the headset. WiVRn's sink appears when the headset connects;
# at that moment it becomes the default output (streams following the default
# move with it). Only on appearance: a default changed by hand later stays.
# $1: file that keeps the output to restore.
xr_audio_follow() {
    local had=0 now prev
    while :; do
        now=0
        pactl list short sinks 2>/dev/null | cut -f2 | grep -qx wivrn.sink && now=1
        if ((now && !had)); then
            prev=$(pactl get-default-sink 2>/dev/null)
            if [[ -n $prev && $prev != wivrn.sink ]] && pactl set-default-sink wivrn.sink; then
                echo "$prev" >"$1"
                say "audio: default output -> wivrn.sink (headset), was $prev"
            fi
        fi
        had=$now
        sleep "${VRDUAL_AUDIO_POLL:-2}"
    done
}

# Puts the output from before back, if the headset's is still the default.
xr_audio_restore() {
    local prev
    prev=$(cat "$1" 2>/dev/null)
    [[ -n $prev && $(pactl get-default-sink 2>/dev/null) == wivrn.sink ]] || return 0
    pactl set-default-sink "$prev" && say "audio: default output -> $prev"
}

wivrn_bg_start() {
    local log=${XDG_RUNTIME_DIR:-/tmp}/vrdual-wivrn.log i
    say "starting wivrn-server in the background (log: $log)"
    (vrdual_wivrn >"$log" 2>&1 &)  # its lock: a parallel start loses and exits, we wait for the winner
    for i in $(seq 20); do pgrep -x wivrn-server >/dev/null && break; sleep 0.5; done
    pgrep -x wivrn-server >/dev/null || { say "error: wivrn-server did not start, see $log"; tail -5 "$log" >&2; return 1; }
    sleep 1  # IPC socket
}

# Stops wivrn-server (ours or not) and starts it again in the background. A
# running `vrdual xr` loses its session and reconnects by itself; the headset
# app has to connect again (its "Connect" button, or autoconnect).
vrdual_wivrn-restart() {
    local i lock=${XDG_RUNTIME_DIR:-/tmp}/vrdual-wivrn.lock
    if pgrep -x wivrn-server >/dev/null; then
        say "stopping wivrn-server (pid $(pgrep -x wivrn-server | paste -sd' '))"
        pkill -x wivrn-server
        for i in $(seq 20); do pgrep -x wivrn-server >/dev/null || break; sleep 0.5; done
        if pgrep -x wivrn-server >/dev/null; then say "still running after 10 s: SIGKILL"; pkill -KILL -x wivrn-server; sleep 1; fi
        flock -w 10 "$lock" true || { say "error: $lock still held"; return 1; }  # the old start's flatpak exited
    fi
    wivrn_bg_start
}

# WiVRn streaming server (Flatpak) for the Quest. Runs in the foreground and
# holds $XDG_RUNTIME_DIR/vrdual-wivrn.lock, so only one starts via vrdual.
vrdual_wivrn() {
    local opts=() lock=${XDG_RUNTIME_DIR:-/tmp}/vrdual-wivrn.lock
    # A second server deletes the first one's IPC socket on exit (apps then fail
    # with "Failed to connect to monado service process").
    if pgrep -x wivrn-server >/dev/null; then
        say "wivrn-server already running (pid $(pgrep -x wivrn-server | paste -sd' ')); stop it first"; return 1
    fi
    systemctl is-active -q avahi-daemon 2>/dev/null || {
        opts+=(--no-publish-service)
        say "avahi-daemon not running: headset will not find the PC by itself — add it by IP: $(ip -4 -o addr show scope global | awk '$2 !~ /docker|veth|br-/ {sub("/.*","",$4); print $4; exit}')"
    }
    local rc=0
    flock -n -E 75 "$lock" flatpak run --command=wivrn-server io.github.wivrn.wivrn "${opts[@]}" "$@" || rc=$?
    ((rc == 75)) && say "wivrn-server already started by another vrdual (lock $lock)"
    return $rc
}

# ------------------------------------------------- feedback (docs/PLAN.md §M) --
# Nothing here sends anything: the commands print prefilled GitHub URLs, the
# user reads the form and submits it (or not). --open opens them in a browser.
VRDUAL_REPO_URL=${VRDUAL_REPO_URL:-https://github.com/adderek/vrdual}

# Play log written by vrdual-xr: start, seconds, app, gpu, profile (tab separated).
games_log() { echo "${XDG_STATE_HOME:-$HOME/.local/state}/vrdual/games.tsv"; }
vrdual_games() {
    local f; f=$(games_log)
    [[ -f $f ]] || { say "no games logged yet ($f; vrdual xr writes it)"; return 0; }
    cat "$f"
}
urlenc() { python3 -I -c 'import sys, urllib.parse as u; print(u.quote(sys.argv[1], safe=""))' "$1"; }
open_urls() { local u; for u; do xdg-open "$u" >/dev/null 2>&1 || say "open: $u"; done; }

# Facts about this machine for a request or report (one "Key: value" per line).
system_facts() {
    local mesa os
    mesa=$(pacman -Q mesa 2>/dev/null | cut -d' ' -f2 || true)
    [[ -n $mesa ]] || mesa=$(dpkg-query -W -f='${Version}' mesa-vulkan-drivers 2>/dev/null || rpm -q --qf '%{VERSION}' mesa-vulkan-drivers 2>/dev/null || true)
    mesa=${mesa#*:}  # package epoch
    os=$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-}")
    local gpu=${1:-$(lspci 2>/dev/null | grep -E 'VGA|3D|Display' | cut -d: -f3- | sed 's/^ //' | sort | uniq -c | sed -E 's/^ *([0-9]+) /\1x /' | paste -sd';' || true)}
    # the layer games load: steam-install's copy, else build/ (each binary carries its own build info)
    local f ver=""
    for f in "$STEAM_FLATPAK"/vrdual/layer/libVkLayer_vrdual64.so "$HOME"/.local/share/vrdual/layer/libVkLayer_vrdual64.so "$B/libVkLayer_vrdual.so"; do
        [[ -f $f ]] && { ver="$(layer_info "$f") (layer ${f/#$HOME/\~})"; break; }
    done
    printf 'GPU: %s\nMesa: %s\nOS: %s\nvrdual: %s\n' "${gpu:-?}" "${mesa:-?}" "${os:-?}" "${ver:-?}"
}

# feedback_args [GAME] [--open]: sets game (default: last one in the play log),
# open, and gpu/secs/prof from the log lines of that game.
feedback_args() {
    local a f; game="" open=0
    for a; do case $a in --open) open=1 ;; *) game=$a ;; esac; done
    f=$(games_log)
    [[ -n $game || ! -f $f ]] || game=$(tail -n1 "$f" | cut -f3)
    [[ -n $game ]] || { say "name the game (no play log yet: $f)"; return 2; }
    gpu="" secs=0 prof=""
    [[ -f $f ]] && IFS=$'\t' read -r gpu secs prof < <(awk -F'\t' -v g="$game" '$3 == g {gpu = $4; s += $2; p = $5} END {print gpu "\t" s+0 "\t" p}' "$f")
    return 0
}

# vrdual_request [GAME] [--open]: ask for a game in Discussions. stdout:
# "search<TAB>URL" (upvote an existing request) and "new<TAB>URL" (prefilled).
vrdual_request() {
    local game open gpu secs prof body
    feedback_args "$@" || return
    body="**Game:** $game
**Store / build:** (Steam / GOG / Epic / other)
**What would you like:** (it runs but needs a profile / it does not run / ...)

---
$([[ -n $prof ]] && printf 'App name seen by vrdual: `%s`' "$game")$( ((secs > 0)) && printf ', played %s min, profile: %s' $((secs / 60)) "${prof:-none}")
$(system_facts "$gpu")"
    local s="$VRDUAL_REPO_URL/discussions/categories/game-requests?discussions_q=$(urlenc "$game")"
    local n="$VRDUAL_REPO_URL/discussions/new?category=game-requests&title=$(urlenc "$game")&body=$(urlenc "$body")"
    say "upvote an existing request if there is one; else open the new one (prefilled, edit before posting):"
    printf 'search\t%s\nnew\t%s\n' "$s" "$n"
    ((open)) && open_urls "$s" "$n"
    return 0
}

# vrdual_report [GAME] [--open]: prefilled game-report issue form
# (.github/ISSUE_TEMPLATE/game-report.yml field ids). Shows the filled fields
# on stderr, the URL on stdout.
vrdual_report() {
    local game open gpu secs prof
    feedback_args "$@" || return
    local facts; facts=$(system_facts "$gpu")
    local -a kv=(
        "game=$game" "exe=$([[ -n $prof ]] && echo "$game")"
        "gpu=$(sed -n 's/^GPU: //p' <<<"$facts"), Mesa $(sed -n 's/^Mesa: //p' <<<"$facts"), $(sed -n 's/^OS: //p' <<<"$facts")"
        "version=$(sed -n 's/^vrdual: //p' <<<"$facts")"
        "notes=$( ((secs > 0)) && printf 'Played %s min with vrdual-xr, profile: %s.' $((secs / 60)) "${prof:-none}")"
    )
    local u="$VRDUAL_REPO_URL/issues/new?template=game-report.yml&title=$(urlenc "[game] $game")" x
    say "prefilled (you fill in store, result and the rest; nothing is sent until you submit):"
    for x in "${kv[@]}"; do
        [[ -n ${x#*=} ]] || continue
        say "  ${x%%=*}: ${x#*=}"
        u+="&${x%%=*}=$(urlenc "${x#*=}")"
    done
    echo "$u"
    ((open)) && open_urls "$u"
    return 0
}

vrdual_snapshot() {
    local out="${1:-$VRDUAL_ROOT/sbs.png}"
    vrdual_run --snapshot "$out" --at "${2:-150}" -- "$B/vrdual-cube" --frames 100000
}

# SBS screenshots -> wiggle GIFs (left/right eye alternating) next to them,
# for the README. Args: PNG files or dirs (default screenshots/). A PNG that
# already has a .gif is skipped. stdout: the GIFs written.
vrdual_wiggle() {
    local f g dx; local -a pngs=()
    (($#)) || set -- "$VRDUAL_ROOT/screenshots"
    shopt -s nullglob
    for f in "$@"; do if [[ -d $f ]]; then pngs+=("$f"/*.png); else pngs+=("$f"); fi; done
    shopt -u nullglob
    for f in "${pngs[@]}"; do
        g=${f%.png}.gif
        [[ -e $g ]] && { say "skip  $g (exists)"; continue; }
        dx=$(python3 -I "$VRDUAL_ROOT/tools/wiggle.py" "$f" "$g") || { say "FAIL  $f"; continue; }
        say "wrote $g (eyes aligned at dx=$dx px)"
        echo "$g"
    done
}

# Automated verification; exit 0 = everything passed. Opens two small windows
# for ~20 s (one per GPU). Uses an empty temporary config, session "selftest".
vrdual_selftest() {
    local tmp fails=0 sess=selftest
    tmp=$(mktemp -d)
    _VRDUAL_SELFTEST_TMP=$tmp
    trap 'kill $(jobs -p) 2>/dev/null || true; rm -rf "${_VRDUAL_SELFTEST_TMP:-/nonexistent}"; rm -f /dev/shm/vrdual-selftest-*; trap - RETURN' RETURN
    check() { if "$@" >"$tmp/out" 2>&1; then say "PASS  $label"; else say "FAIL  $label"; sed 's/^/      /' "$tmp/out" >&2; fails=$((fails+1)); fi; }
    vrdual_build || return 1

    # 1. SPIR-V patcher: baked + live variants must validate; non-vertex must be refused.
    glslc "$VRDUAL_ROOT/testapp/cube.vert" -o "$tmp/glsl.spv"
    glslc -fshader-stage=vertex -x hlsl "$VRDUAL_ROOT/tools/test-shaders/hlsl_vs.hlsl" -o "$tmp/hlsl.spv"
    glslc "$VRDUAL_ROOT/testapp/cube.frag" -o "$tmp/frag.spv"
    local sh m
    for sh in glsl hlsl; do
        for m in "baked 0.03 0.02 5 0.25" "live 0x123456789a0"; do
            label="spirv $sh ${m%% *}"
            # shellcheck disable=SC2086
            check bash -c "'$B/spvpatch' '$tmp/$sh.spv' '$tmp/p.spv' $m && spirv-val --target-env vulkan1.1 '$tmp/p.spv'"
        done
    done
    label="spirv fragment refused"; check bash -c "! '$B/spvpatch' '$tmp/frag.spv' '$tmp/p.spv' baked 0.1"
    label="built-in game profile: Psychonauts gets skip_w1 = 0"
    check bash -c "VRDUAL_CONFIG=/nonexistent '$B/vrdual-ctl' show Psychonauts | grep -q '^skip_w1 *0 *# built-in'"
    label="build info: vrdual version lists tools and layers; SOURCE_DATE_EPOCH fixes the time"
    check bash -c "v=\$('$VRDUAL_ROOT/vrdual' version) && grep -q \$'^tools\tvrdual .*, built .* on ' <<<\"\$v\" &&
        grep -q 'build/libVkLayer_vrdual.so.*, built ' <<<\"\$v\" &&
        SOURCE_DATE_EPOCH=0 '$VRDUAL_ROOT/tools/build_info.sh' | grep -q ', built 1970-01-01 00:00:00 +0000 on ' || { echo \"\$v\"; false; }"
    label="feedback: request / report URLs prefilled from the play log, nothing sent"
    check bash -c "export XDG_STATE_HOME='$tmp/fb'; mkdir -p \$XDG_STATE_HOME/vrdual
        printf '2026-10-21 10:00:00\t600\tmirrorsedge.exe\tAMD Radeon RX 7900 XTX (RADV NAVI31)\tbuilt-in\n' >\$XDG_STATE_HOME/vrdual/games.tsv
        r=\$('$VRDUAL_ROOT/vrdual' request 2>/dev/null) && p=\$('$VRDUAL_ROOT/vrdual' report 2>/dev/null) &&
        grep -q \$'^search\thttps://github.com/.*/discussions/categories/game-requests?discussions_q=mirrorsedge.exe\$' <<<\"\$r\" &&
        grep -q \$'^new\thttps://github.com/.*/discussions/new?category=game-requests&title=mirrorsedge.exe&body=.*played%2010%20min' <<<\"\$r\" &&
        grep -q '/issues/new?template=game-report.yml&title=%5Bgame%5D%20mirrorsedge.exe&game=mirrorsedge.exe&exe=mirrorsedge.exe&gpu=AMD%20Radeon' <<<\"\$p\" &&
        grep -q '&version=vrdual%20.*%2C%20built%20.*%28layer%20' <<<\"\$p\" &&
        grep -q '&notes=Played%2010%20min.*built-in' <<<\"\$p\" || { echo \"\$r\"; echo \"\$p\"; false; }"
    label="docs/CONFIG.md lists every config key"
    check bash -c "VRDUAL_CONFIG=/nonexistent '$B/vrdual-ctl' show | awk '{print \$1}' | while read -r k; do grep -q \"\\\`\$k\\\`\" '$VRDUAL_ROOT/docs/CONFIG.md' || { echo \"missing: \$k\"; exit 1; }; done"

    # 2. End to end on both GPUs: static calibration scene, live changes via the control block.
    export VRDUAL_CONFIG="$tmp/empty.conf"; : >"$VRDUAL_CONFIG"
    export XDG_STATE_HOME="$tmp/state"  # vrdual-xr's play log
    # Checks 2, 3, 3b and 4a need the second GPU (0b); single-GPU hosts skip them.
    local two=1
    [[ $(cat /sys/bus/pci/devices/0000:0b:00.0/class 2>/dev/null) == 0x03* ]] || two=0
    snap() {  # newest paired frame at least 15 frames after now
        local f
        f=$("$B/vrdual-compositor" --session $sess --snapshot "$1" --at 0 --timeout 20 2>&1 | grep -oE 'frame [0-9]+' | cut -d' ' -f2)
        [[ -n $f ]] && "$B/vrdual-compositor" --session $sess --snapshot "$1" --at $((f + 15)) --timeout 20 >/dev/null 2>&1
    }
    set_live() { local kv; for kv in "$@"; do "$B/vrdual-ctl" --session $sess set ${kv/=/ } >/dev/null || return 1; done; }
    local M="python3 -I $VRDUAL_ROOT/tools/measure_posts.py"
    local i
    if (( two )); then
    rm -f /dev/shm/vrdual-$sess-*
    local e
    for e in left right; do
        env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=$e \
            "$B/vrdual-cube" --scene calib --title "selftest $e" >"$tmp/$e.log" 2>&1 &
    done
    for i in $(seq 100); do grep -q exporting "$tmp/left.log" && grep -q exporting "$tmp/right.log" && break; sleep 0.1; done
    label="two GPUs selected";   check bash -c "grep -q 'pci 0000:06:00.0' '$tmp/left.log' && grep -q 'pci 0000:0b:00.0' '$tmp/right.log'"
    label="live params enabled"; check grep -q 'live params at device address' "$tmp/left.log" "$tmp/right.log"
    label="default ipd 64mm";    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/a.png' && $M '$tmp/a.png' --ipd 0.064 --anchor center"
    set_live ipd=0.2
    label="live ipd 200mm";      check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/b.png' && $M '$tmp/b.png' --ipd 0.2 --anchor center"
    set_live ipd=0.064 anchor=left
    label="anchor left";         check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/c.png' && $M '$tmp/c.png' --ipd 0.064 --anchor left"
    set_live anchor=right
    label="anchor right";        check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/d.png' && $M '$tmp/d.png' --ipd 0.064 --anchor right"
    set_live anchor=center ipd_near=0.2 near_dist=1 far_dist=5
    label="near/far blend";      check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/e.png' && $M '$tmp/e.png' --ipd 0.064 --ipd-near 0.2 --near 1 --far 5"
    label="save: profile without ipd keys, --global with them"
    check bash -c "export VRDUAL_CONFIG='$tmp/save.conf'; c='$B/vrdual-ctl --session $sess'; \$c save >/dev/null 2>&1 && \$c save --global >/dev/null 2>&1 &&
        awk 'BEGIN{s=\"[global]\"} /^\[/{s=\$0} /^(ipd|ipd_near|near_dist|far_dist) /{print s}' '$tmp/save.conf' | sort -u | grep -qx '\[global\]' &&
        ! awk 'BEGIN{s=\"[global]\"} /^\[/{s=\$0} /^(ipd|ipd_near|near_dist|far_dist) /{print s}' '$tmp/save.conf' | grep -q app: && grep -q '^\[app:' '$tmp/save.conf'"
    kill $(jobs -p) 2>/dev/null; wait 2>/dev/null

    # 3. Mirror mode: ONE process, the app sees one GPU, the layer replays on the other.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --clear-alpha 0 --title "selftest mirror" >"$tmp/mirror.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images' "$tmp/mirror.log" && break; sleep 0.1; done
    label="build info: layer logs version, ISO build time and this machine"
    check grep -qE "^\[vrdual:LR\] vrdual [^ ]+, built [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4} on $(uname -n) \(64-bit layer\)$" "$tmp/mirror.log"
    label="mirror: app sees 1 GPU, twin on 0b"; check bash -c "grep -q 'app sees 1 GPU' '$tmp/mirror.log' && grep -q 'twin device on .*0000:0b:00.0' '$tmp/mirror.log'"
    label="mirror: app clears alpha 0, frame file alpha 255"
    check bash -c "for i in \$(seq 100); do a=\$(python3 -I '$VRDUAL_ROOT/tools/frame_hash.py' --alpha /dev/shm/vrdual-$sess-0) && break; sleep 0.1; done; [ \"\$a\" = 255 ]"
    label="mirror: default ipd 64mm"; check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/m1.png' && $M '$tmp/m1.png' --ipd 0.064 --anchor center"
    set_live ipd=0.2
    label="mirror: live ipd 200mm";   check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/m2.png' && $M '$tmp/m2.png' --ipd 0.2 --anchor center"
    set_live ipd=0.064 head_x=0.05
    label="mirror: head offset 50mm right"; check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/m3.png' && $M '$tmp/m3.png' --ipd 0.064 --anchor center --head-x 0.05"
    set_live head_x=0
    kill $(jobs -p) 2>/dev/null; wait 2>/dev/null

    # 3b. Mirror with Vulkan 1.4 paths DXVK 3 needs: device addresses (captured on
    # A, replayed on B) and vkMapMemory2. Wrong addresses on B = garbage right eye.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --bda --late-verts 60 --title "selftest bda" >"$tmp/bda.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images' "$tmp/bda.log" && break; sleep 0.1; done
    # Vertices are written at frame 60, long after the first sync: with dirty
    # tracking on, only a scan that sees that write gets them to B (right eye).
    label="mirror bda: addresses replayed, late vertex write reaches B (dirty tracking on), ipd 64mm"
    check bash -c "grep -q 'device addresses replayed' '$tmp/bda.log' && grep -q 'dirty tracking on' '$tmp/bda.log' &&
        '$B/vrdual-compositor' --session $sess --snapshot '$tmp/bda.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
        $M '$tmp/bda.png' --ipd 0.064 --anchor center && ! grep -q STOPPED '$tmp/bda.log' || { cat '$tmp/bda.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    label="mirror: cached write tracking off by default (cached_wp = 0)"
    check bash -c "grep -q 'device addresses replayed' '$tmp/bda.log' && ! grep -q 'cached write tracking on' '$tmp/bda.log'"

    # 3b2. Cached (readback) memory, default: shadowed like the rest. The late
    # vertex write is a pread(2) straight into the mapping (kernel writes: UE3
    # texture streaming; they fail with cached_wp = 1), and every frame the GPU
    # fills a HOST_CACHED buffer the app reads back after the fence (write-back).
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --bda --cached --late-verts 60 --verts-file --readback --title "selftest cached shadow" >"$tmp/cs.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images' "$tmp/cs.log" && break; sleep 0.1; done
    label="mirror cached shadow: pread into the mapping reaches both eyes, GPU fills read back (ipd 64mm)"
    check bash -c "'$B/vrdual-compositor' --session $sess --snapshot '$tmp/cs.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
        $M '$tmp/cs.png' --ipd 0.064 --anchor center && for i in \$(seq 100); do grep -q '^readback: [1-9][0-9]* ok' '$tmp/cs.log' && break; sleep 0.1; done &&
        grep -q '^readback: [1-9][0-9]* ok, 0 bad' '$tmp/cs.log' && ! grep -q 'readback: .* [1-9][0-9]* bad' '$tmp/cs.log' &&
        ! grep -q 'pread into the mapping' '$tmp/cs.log' && ! grep -q STOPPED '$tmp/cs.log' || { cat '$tmp/cs.log'; false; }"
    label="mirror write-back: a storage buffer in readback memory is logged once (shader stores are not copied back)"
    check bash -c "[[ \$(grep -c 'storage buffer in readback memory' '$tmp/cs.log') == 1 ]] || { grep mirror '$tmp/cs.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3b3. 10-bit swapchain (UE4 games pick A2B10G10R10 even with HDR off):
    # exported through a blit to 8-bit, both eyes.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --swapchain-format a2b10g10r10 --title "selftest 10-bit" >"$tmp/tb.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images\|not offered' "$tmp/tb.log" && break; sleep 0.1; done
    if grep -q 'not offered' "$tmp/tb.log"; then
        say "SKIP  10-bit swapchain (the surface offers no A2B10G10R10)"
    else
        label="mirror 10-bit swapchain: exported through a blit to 8-bit, ipd 64mm"
        check bash -c "grep -q 'exported through a blit' '$tmp/tb.log' && '$B/vrdual-compositor' --session $sess --snapshot '$tmp/tb.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
            $M '$tmp/tb.png' --ipd 0.064 --anchor center && ! grep -q STOPPED '$tmp/tb.log' || { cat '$tmp/tb.log'; false; }"
    fi
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3c. Cached write tracking (cached_wp = 1): HOST_CACHED mapping protected per block; the late
    # vertex write must fault, be recorded and reach B.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_CACHED_WP=1 \
        "$B/vrdual-cube" --scene calib --bda --cached --late-verts 60 --title "selftest cached wp" >"$tmp/wp.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images' "$tmp/wp.log" && break; sleep 0.1; done
    label="mirror cached write tracking: late write faults and reaches B, ipd 64mm"
    check bash -c "grep -q 'cached write tracking on' '$tmp/wp.log' &&
        '$B/vrdual-compositor' --session $sess --snapshot '$tmp/wp.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
        $M '$tmp/wp.png' --ipd 0.064 --anchor center && ! grep -q STOPPED '$tmp/wp.log' || { cat '$tmp/wp.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    else
        say "SKIP  two-GPU checks (no GPU at 0000:0b:00.0)"
    fi

    # 3c. Two swapchains (wined3d style): the small one is created last and must
    # neither take the frame file nor crash the big one's export.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --extra-window --title "selftest 2 swapchains" >"$tmp/xw.log" 2>&1 &
    local xw=$!
    for i in $(seq 100); do grep -q 'exporting' "$tmp/xw.log" && break; sleep 0.1; done
    label="mirror: 2 swapchains, biggest exported, ipd 64mm"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/xw.png' && $M '$tmp/xw.png' --ipd 0.064 --anchor center &&
        kill -0 $xw && ! grep -q 'exporting 64x48' '$tmp/xw.log' || { cat '$tmp/xw.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3d. Single-GPU mode: right_gpu = the app's GPU -> alternate-eye rendering
    # on that GPU (no twin device). With --bda the app's own device addresses
    # must keep working (a twin on the same GPU could not replay them).
    local opt
    for opt in "" --bda; do
        rm -f /dev/shm/vrdual-$sess-*
        env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
            VRDUAL_RIGHT_GPU=pci:0000:06:00.0 "$B/vrdual-cube" --scene calib $opt --title "selftest one gpu" >"$tmp/one.log" 2>&1 &
        for i in $(seq 100); do grep -q 'exporting' "$tmp/one.log" && break; sleep 0.1; done
        label="single GPU${opt:+ $opt}: alternate eyes on 06, ipd 64mm"
        check bash -c "$(declare -f snap); B='$B' sess=$sess; grep -q 'alternate-eye rendering on .*0000:06:00.0' '$tmp/one.log' &&
            snap '$tmp/one.png' && $M '$tmp/one.png' --ipd 0.064 --anchor center || { cat '$tmp/one.log'; false; }"
        if [[ -z $opt ]]; then  # HUD (w == 1) moved from infinity to 1.5 m
            set_live hud_depth=1.5
            label="hud_depth 1.5m: HUD disparity, posts unchanged"
            check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/hud.png' && $M '$tmp/hud.png' --ipd 0.064 --anchor center --hud-depth 1.5"
        fi
        kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true
    done

    # 4. Mirror mode under Zink (OpenGL 2.1-era app), 64- and 32-bit; eyes must differ.
    local gl
    for gl in "$B/vrdual-gltest" "$B/lib32/vrdual-gltest"; do
        [[ -x $gl ]] || { say "SKIP  mirror zink $(basename "$(dirname "$gl")") (make lib32)"; continue; }
        rm -f /dev/shm/vrdual-$sess-*
        env __GLX_VENDOR_LIBRARY_NAME=mesa MESA_LOADER_DRIVER_OVERRIDE=zink VK_ADD_LAYER_PATH="$(dirname "$gl")" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo \
            VRDUAL_SESSION=$sess VRDUAL_EYE=both "$gl" --title "selftest zink" >"$tmp/gl.log" 2>&1 &
        label="mirror zink $(file -b "$gl" | cut -d, -f1 | cut -d' ' -f2): both eyes, not stopped, dirty tracking on"
        check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/g.png' && grep -q 'zink' '$tmp/gl.log' && ! grep -q STOPPED '$tmp/gl.log' &&
            grep -q 'dirty tracking on' '$tmp/gl.log' &&
            [ \"\$(magick '$tmp/g.png' -crop 50%x100% +repage -format '%#\n' info: | sort -u | wc -l)\" = 2 ]"
        # the X11 cursor goes out with the frames (games with a hardware cursor)
        label="cursor $(file -b "$gl" | cut -d, -f1 | cut -d' ' -f2): X11 cursor image in the frame header"
        check bash -c "grep -q 'cursor: X11 cursor exported' '$tmp/gl.log' && c=\$(python3 -I '$VRDUAL_ROOT/tools/frame_hash.py' --cursor /dev/shm/vrdual-$sess-0) &&
            set -- \$c && [[ \$3 -gt 0 && \$4 -gt 0 ]] || { echo \"cursor: \$c\"; grep cursor '$tmp/gl.log'; false; }"
        kill $(jobs -p) 2>/dev/null; wait 2>/dev/null
    done
    # 4a. Mirror stopped on purpose in a 32-bit GL app (transient maps, like
    # Alice): the game must keep rendering fresh data (its shadowed uploads
    # still reach A), only the right eye freezes. gltest animates its texture.
    if [[ -x $B/lib32/vrdual-gltest ]] && (( two )); then
        rm -f /dev/shm/vrdual-$sess-*
        env __GLX_VENDOR_LIBRARY_NAME=mesa MESA_LOADER_DRIVER_OVERRIDE=zink VK_ADD_LAYER_PATH="$B/lib32" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo \
            VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_MIRROR_FAIL_AT=30 "$B/lib32/vrdual-gltest" --title "selftest stop" >"$tmp/stop.log" 2>&1 &
        local gp=$!
        for i in $(seq 300); do grep -q STOPPED "$tmp/stop.log" && break; sleep 0.1; done
        sleep 0.5
        label="mirror stopped: app alive, left eye still animating"
        # occluded windows get ~1 frame/s from XWayland: wait for 2 new frames, not a fixed time
        check bash -c "a=\$(python3 -I '$VRDUAL_ROOT/tools/frame_hash.py' /dev/shm/vrdual-$sess-0);
            for i in \$(seq 50); do b=\$(python3 -I '$VRDUAL_ROOT/tools/frame_hash.py' /dev/shm/vrdual-$sess-0);
                [ \"\${b% *}\" -ge \$(( \${a% *} + 2 )) ] && break; sleep 0.1; done; echo \"\$a / \$b\";
            grep -q 'VRDUAL_MIRROR_FAIL_AT reached' '$tmp/stop.log' && kill -0 $gp && [ \"\${a#* }\" != \"\${b#* }\" ] && [ \"\${a% *}\" != \"\${b% *}\" ]"
        kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true
    fi

    # 4c. VRDUAL_BACKTRACE=1: SIGABRT logs native frames (module + offset), then the app dies as before.
    if [[ -x $B/vrdual-gltest ]]; then
        env __GLX_VENDOR_LIBRARY_NAME=mesa MESA_LOADER_DRIVER_OVERRIDE=zink VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo \
            VRDUAL_BACKTRACE=1 "$B/vrdual-gltest" --title "selftest abort" >"$tmp/bt.log" 2>&1 &
        local bp=$!
        for i in $(seq 100); do grep -q GL_RENDERER "$tmp/bt.log" && break; sleep 0.1; done
        local brc=0; kill -ABRT $bp 2>/dev/null; wait $bp 2>/dev/null || brc=$?
        label="backtrace: SIGABRT logs the frames, the app still aborts"
        check bash -c "(( $brc == 134 )) && grep -q 'SIGABRT in thread' '$tmp/bt.log' && grep -q '#0 .*libVkLayer_vrdual.so + 0x' '$tmp/bt.log' || { echo rc $brc; cat '$tmp/bt.log'; false; }"
    fi

    # 4b. Input mapping (controllers -> pad / mouse / keys) and a uinput pad round trip.
    label="input: mapper scenarios$( "$B/vrdual-input-test" 2>/dev/null | grep -q '^skip  uinput' && echo ' (uinput skipped: module not loaded)' || echo ', uinput pad read back')"
    check "$B/vrdual-input-test"

    # audio: the headset's sink becomes the default when it appears, a later
    # manual choice stays, the old default comes back (fake pactl)
    mkdir -p "$tmp/pa" && cat >"$tmp/pa/pactl" <<'PA' && chmod +x "$tmp/pa/pactl"
#!/bin/sh
d=$(dirname "$0")
case "$1 $2" in
"list short") n=0; while read -r s; do n=$((n+1)); printf '%s\t%s\tPipeWire\n' $n "$s"; done <"$d/sinks" ;;
"get-default-sink "*) cat "$d/default" ;;
"set-default-sink "*) echo "$2" >"$d/default" ;;
esac
PA
    label="vrdual xr audio: default -> wivrn.sink on connect, manual choice kept, restored on exit"
    check bash -c "export PATH='$tmp/pa':\$PATH VRDUAL_AUDIO_POLL=0.1; source '$VRDUAL_ROOT/_'; d='$tmp/pa'
        echo hdmi >\$d/sinks; echo hdmi >\$d/default; st=\$(mktemp)
        xr_audio_follow \$st 2>/dev/null & p=\$!
        sleep 0.4; [[ \$(cat \$d/default) == hdmi ]] || { echo 'switched without a headset'; kill \$p; exit 1; }
        echo wivrn.sink >>\$d/sinks; sleep 0.4; [[ \$(cat \$d/default) == wivrn.sink ]] || { echo 'not switched'; kill \$p; exit 1; }
        echo manual >\$d/default; sleep 0.4; [[ \$(cat \$d/default) == manual ]] || { echo 'manual choice overridden'; kill \$p; exit 1; }
        echo wivrn.sink >\$d/default; kill \$p; wait \$p 2>/dev/null || true; xr_audio_restore \$st 2>/dev/null
        [[ \$(cat \$d/default) == hdmi ]] || { echo \"not restored: \$(cat \$d/default)\"; exit 1; }"
    label="vrdual xr audio: Ctrl-C on xr still restores the output"
    mkdir -p "$tmp/pa/b" && printf '#!/bin/sh\nexec sleep 30\n' >"$tmp/pa/b/vrdual-xr" && chmod +x "$tmp/pa/b/vrdual-xr"
    printf '#!/bin/sh\nexit 0\n' >"$tmp/pa/pgrep" && chmod +x "$tmp/pa/pgrep"  # wivrn-server "runs"
    check bash -c "d='$tmp/pa'; printf 'hdmi\nwivrn.sink\n' >\$d/sinks; echo hdmi >\$d/default
        # background jobs start with SIGINT ignored; a terminal's Ctrl-C does not: default it again
        setsid python3 -I -c 'import os,signal,sys; signal.signal(signal.SIGINT, signal.SIG_DFL); os.execvp(sys.argv[1], sys.argv[1:])' \\
            bash -c \"export PATH=\$d:\\\$PATH VRDUAL_AUDIO_POLL=0.1 XR_RUNTIME_JSON=/x/openxr_wivrn.json; source '$VRDUAL_ROOT/_'; B=\$d/b; vrdual_xr --session none || true; echo done >\$d/exited\" 2>/dev/null & p=\$!
        for i in \$(seq 30); do [[ \$(cat \$d/default) == wivrn.sink ]] && break; sleep 0.1; done
        [[ \$(cat \$d/default) == wivrn.sink ]] || { echo 'not switched'; kill -- -\$p; exit 1; }
        kill -INT -- -\$p; for i in \$(seq 30); do [[ -e \$d/exited ]] && break; sleep 0.1; done
        [[ -e \$d/exited && \$(cat \$d/default) == hdmi ]] || { echo \"exited: \$(cat \$d/exited 2>/dev/null) default: \$(cat \$d/default)\"; kill -- -\$p 2>/dev/null; exit 1; }"
    label="vrdual xr --no-start-wivrn: refuses without wivrn-server"
    mkdir -p "$tmp/nopgrep" && printf '#!/bin/sh\nexit 1\n' >"$tmp/nopgrep/pgrep" && chmod +x "$tmp/nopgrep/pgrep"
    printf '#!/bin/sh\nsleep 3\n' >"$tmp/nopgrep/flatpak" && chmod +x "$tmp/nopgrep/flatpak"  # fake server
    check bash -c "out=\$(PATH='$tmp/nopgrep':\$PATH XR_RUNTIME_JSON=/x/openxr_wivrn.json '$VRDUAL_ROOT/vrdual' xr --no-start-wivrn --session none 2>&1); rc=\$?
        [[ \$rc != 0 ]] && grep -q 'wivrn-server is not running' <<<\"\$out\" || { echo \"rc=\$rc \$out\"; false; }"
    label="vrdual wivrn-restart: stops the server, waits for the lock, starts it again"
    mkdir -p "$tmp/fakew" && printf '#!/bin/sh\n[ -f %s/fakew/running ] && echo 4242\n' "$tmp" >"$tmp/fakew/pgrep"
    printf '#!/bin/sh\necho "$*" >>%s/fakew/killed; rm -f %s/fakew/running\n' "$tmp" "$tmp" >"$tmp/fakew/pkill"
    printf '#!/bin/sh\ntouch %s/fakew/running; sleep 2\n' "$tmp" >"$tmp/fakew/flatpak"
    chmod +x "$tmp/fakew/"*
    check bash -c "export PATH='$tmp/fakew':\$PATH XDG_RUNTIME_DIR='$tmp/fakew'; '$VRDUAL_ROOT/vrdual' wivrn >/dev/null 2>&1 & sleep 0.5
        out=\$('$VRDUAL_ROOT/vrdual' wivrn-restart 2>&1); rc=\$?; wait
        [[ \$rc == 0 ]] && grep -q stopping <<<\"\$out\" && grep -q 'starting wivrn-server' <<<\"\$out\" && grep -qx -- '-x wivrn-server' '$tmp/fakew/killed' || { echo \"rc=\$rc \$out\"; false; }"
    label="vrdual wivrn: a second start loses the lock"
    check bash -c "export PATH='$tmp/nopgrep':\$PATH XDG_RUNTIME_DIR='$tmp'; '$VRDUAL_ROOT/vrdual' wivrn >/dev/null 2>&1 & p=\$!; sleep 0.5
        '$VRDUAL_ROOT/vrdual' wivrn 2>&1 | tee '$tmp/w2.log'; rc=\${PIPESTATUS[0]}; wait \$p
        [[ \$rc == 75 ]] && grep -q 'by another vrdual' '$tmp/w2.log'"

    # 5. OpenXR output against Monado's simulated HMD (null compositor, no window).
    local xrj="${VRDUAL_XR_TEST_RUNTIME:-$B/monado/openxr_monado.json}"
    if [[ -f $xrj ]]; then
        rm -f /dev/shm/vrdual-$sess-*
        env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
            "$B/vrdual-cube" --scene calib --title "selftest xr" >"$tmp/xrsrc.log" 2>&1 &
        local src=$!
        label="openxr: focused session, 60 frames submitted"
        check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 VRDUAL_HEAD_LEAN=on VRDUAL_XR_OVERLAY_DUMP='$tmp/ov.pam' timeout 30 '$B/vrdual-xr' --session $sess --frames 60 >'$tmp/xr.log' 2>&1;
            grep -q 'session state 5' '$tmp/xr.log' && grep -q '60 frames submitted' '$tmp/xr.log' || { cat '$tmp/xr.log'; false; }"
        label="openxr: overlay notice (game started, settings) accepted by the runtime"
        check bash -c "grep -q 'overlay: game started' '$tmp/xr.log' && ! grep -q 'overlay unavailable' '$tmp/xr.log' && head -c 200 '$tmp/ov.pam' | grep -q 'WIDTH 1024' &&
            [[ \$(stat -c %s '$tmp/ov.pam') -gt 524288 ]] || { grep overlay '$tmp/xr.log'; false; }"
        label="openxr: controller actions, input profile from the frame file"
        check bash -c "grep -q 'controller actions attached' '$tmp/xr.log' && grep -q \"app 'vrdual-cube': input=off .*head_lean=on\" '$tmp/xr.log' || { cat '$tmp/xr.log'; false; }"
        local sm  # cinema screen: quad / cylinder pair accepted by the runtime
        for sm in flat:world curved:head full:head; do  # default lock = world
            label="openxr: screen=${sm%:*} lock ${sm#*:}, 30 frames submitted"
            check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 VRDUAL_SCREEN=${sm%:*} VRDUAL_SCREEN_SCALE_Y=0.8 timeout 30 '$B/vrdual-xr' --session $sess --frames 30 --lock ${sm#*:} >'$tmp/xr-${sm%:*}.log' 2>&1;
                grep -q 'screen: ${sm%:*}.*scale 1 x 0.8' '$tmp/xr-${sm%:*}.log' && grep -q '30 frames submitted' '$tmp/xr-${sm%:*}.log' || { cat '$tmp/xr-${sm%:*}.log'; false; }"
        done
        label="openxr: session lost -> reconnects in a new process"
        check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 VRDUAL_XR_LOSE_AT=20 timeout 40 '$B/vrdual-xr' --session $sess --frames 30 >'$tmp/xr6.log' 2>&1;
            rc=\$?; [[ \$rc == 0 ]] && grep -q 'reconnecting' '$tmp/xr6.log' && [[ \$(grep -c 'session state 5' '$tmp/xr6.log') == 2 ]] && grep -q '30 frames submitted' '$tmp/xr6.log' || { echo rc=\$rc; grep '\\[xr\\]' '$tmp/xr6.log'; false; }"
        # game exits while streaming: WiVRn keeps the last image unless we send black
        label="openxr: black frame after the game exits"
        check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 timeout 30 '$B/vrdual-xr' --session $sess >'$tmp/xr3.log' 2>&1 & p=\$!
            for i in \$(seq 40); do grep -q 'first frame' '$tmp/xr3.log' && break; sleep 0.5; done; kill $src
            for i in \$(seq 10); do grep -q 'blank frame submitted' '$tmp/xr3.log' && break; sleep 0.5; done; kill \$p; wait \$p
            grep -q 'first frame' '$tmp/xr3.log' && grep -q 'blank frame submitted' '$tmp/xr3.log' || { cat '$tmp/xr3.log'; false; }"
        kill $src 2>/dev/null || true; wait 2>/dev/null || true
        # game gone, frame files left behind: the headset must not get the frozen frame
        sleep 2
        label="openxr: stale frames not shown"
        check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 timeout 20 '$B/vrdual-xr' --session $sess --frames 1 >'$tmp/xr2.log' 2>&1 & p=\$!
            for i in \$(seq 40); do grep -q 'session state 5' '$tmp/xr2.log' && break; sleep 0.5; done; sleep 2; kill \$p; wait \$p
            grep -q 'session state 5' '$tmp/xr2.log' && grep -q 'no game frames' '$tmp/xr2.log' && ! grep -q 'frames submitted' '$tmp/xr2.log' || { cat '$tmp/xr2.log'; false; }"
        label="openxr: Ctrl-C exits within 4 s"
        check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 '$B/vrdual-xr' --session $sess >'$tmp/xr4.log' 2>&1 & p=\$!
            for i in \$(seq 40); do grep -q 'session state 5' '$tmp/xr4.log' && break; sleep 0.5; done; kill -INT \$p
            for i in \$(seq 8); do kill -0 \$p 2>/dev/null || break; sleep 0.5; done
            if kill -0 \$p 2>/dev/null; then kill -9 \$p; cat '$tmp/xr4.log'; false; fi"
        # X11 game (gltest via Zink): its cursor reaches vrdual-xr, which draws it
        if [[ -x $B/vrdual-gltest ]]; then
            rm -f /dev/shm/vrdual-$sess-*
            env __GLX_VENDOR_LIBRARY_NAME=mesa MESA_LOADER_DRIVER_OVERRIDE=zink VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo \
                VRDUAL_SESSION=$sess VRDUAL_EYE=both "$B/vrdual-gltest" --title "selftest xr cursor" >"$tmp/xrgl.log" 2>&1 &
            local gp=$!
            for i in $(seq 100); do grep -q exporting "$tmp/xrgl.log" && break; sleep 0.1; done
            label="openxr: game's X11 cursor drawn"
            check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 timeout 30 '$B/vrdual-xr' --session $sess --frames 30 >'$tmp/xr7.log' 2>&1;
                grep -q 'cursor [0-9]*x[0-9]* from the game' '$tmp/xr7.log' && grep -q '30 frames submitted' '$tmp/xr7.log' || { grep '\\[xr\\]' '$tmp/xr7.log'; false; }"
            kill $gp 2>/dev/null || true; wait $gp 2>/dev/null || true
        fi
        # xr first, then two games one after another: it finds the session in the
        # second dir, reloads on the new process; the new game re-seeds the block
        rm -f /dev/shm/vrdual-$sess-*
        local cube="exec env VK_ADD_LAYER_PATH='$B' VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both '$B/vrdual-cube' --scene calib --title 'selftest xr2'"
        label="openxr: started before the games, follows a game restart"
        check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 VRDUAL_SHM_DIR='$tmp/none:/dev/shm' VRDUAL_XR_STATS=1 timeout 60 '$B/vrdual-xr' --session $sess >'$tmp/xr5.log' 2>&1 & p=\$!
            w() { for i in \$(seq 40); do [[ \$(grep -c \"\$1\" '$tmp/xr5.log') -ge \$2 ]] && return 0; sleep 0.5; done; return 1; }
            w 'session state 5' 1; $cube >'$tmp/g1.log' 2>&1 & g=\$!
            w 'game frames arriving' 1; kill \$g; wait \$g; w 'no game frames' 2
            VRDUAL_HFOV=70 $cube >'$tmp/g2.log' 2>&1 & g=\$!
            w 'game frames arriving' 2; ok=\$?; hf=\$('$B/vrdual-ctl' live --session $sess 2>/dev/null | awk '\$1==\"hfov\"{print \$2}')
            kill \$g \$p; wait
            [[ \$ok == 0 ]] && grep -q 'found in /dev/shm' '$tmp/xr5.log' && grep -q 'new frame sequence' '$tmp/xr5.log' && [[ \$(grep -c \"app 'vrdual-cube'\" '$tmp/xr5.log') -ge 2 ]] &&
                grep -q 're-seeded' '$tmp/g2.log' && [[ \$hf == 70 ]] || { echo hfov=\$hf; cat '$tmp/xr5.log'; grep 'control block' '$tmp/g2.log'; false; }"
        label="openxr: stats line (game fps, headset Hz, frame age, L-R skew)"
        check grep -qE 'new game frames \([0-9.]+/s\), headset [0-9.]+ Hz, [0-9]+ without a new game frame, frame age [0-9.]+ ms avg / [0-9.]+ max \(layer publish -> upload\), L-R [0-9.]+ ms' "$tmp/xr5.log"
        label="openxr: edge mask at each eye's outer edge (ipd 64 mm, hfov 90, 960 px: 15 px)"
        check bash -c "grep -q 'eye 0: edge mask 15 px at the left edge' '$tmp/xr5.log' && grep -q 'eye 1: edge mask 15 px at the right edge' '$tmp/xr5.log' ||
            { grep 'edge mask' '$tmp/xr5.log'; false; }"
        label="openxr: play log has one line per game process, no-profile hint"
        check bash -c "f='$tmp/state/vrdual/games.tsv'; [[ \$(grep -cE \$'^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8}\t[0-9]+\tvrdual-cube\t[^\t]+\tnone\$' \"\$f\") -ge 2 ]] &&
            grep -q \"no vrdual profile for 'vrdual-cube'\" '$tmp/xr5.log' || { cat \"\$f\"; false; }"
    else
        say "SKIP  openxr (no Monado build at $xrj; see docs/ARCHITECTURE.md)"
    fi
    label="wiggle: SBS png -> 2-frame gif, existing gif skipped"
    check bash -c "cp '$VRDUAL_ROOT/docs/sbs-example.png' '$tmp/w.png' && cd '$VRDUAL_ROOT' && source ./_ &&
        [[ \$(vrdual_wiggle '$tmp') == '$tmp/w.gif' ]] && [[ \$(identify '$tmp/w.gif' | wc -l) == 2 ]] && [[ -z \$(vrdual_wiggle '$tmp') ]]"
    unset VRDUAL_CONFIG XDG_STATE_HOME
    if ((fails)); then say "selftest: $fails FAILED"; return 1; fi
    say "selftest: all passed"
}

vrdual_help() {
    cat >&2 <<'EOF'
vrdual — dual-GPU per-eye rendering PoC (see README.md)

  build                         compile layer, test app, compositor
  gpus                          list GPUs + narrowest PCIe link on the path to the CPU
  demo                          vrdual-cube on both GPUs + live side-by-side window
  calib                         IPD calibration scene (posts at 0.5..20 m); keys in the window:
                                  Up/Down IPD, PgUp/PgDn near IPD, N near/far on/off,
                                  A anchor, -/= HFOV, W save to profile, H help, S swap
  config [show [APP]|init|path] config file (~/.config/vrdual/vrdual.conf) and effective values
  live | set KEY VALUE | save   running session: show / change (e.g. "set ipd 64.5mm") / persist
  snapshot [out.png] [frame]    same, but save one paired SBS frame and exit
  wiggle [PNG|DIR...]           SBS screenshots -> wiggle GIFs next to them (default
                                  screenshots/; skips PNGs that already have a .gif)
  steam-install                 install layer + wrapper for Steam (Flatpak or native); prints
                                  the launch option:  .../vrdual/run %command%
  view [--session S]            SBS window of a running game (finds Flatpak Steam sessions)
  xr [--session S] [--lock world|head] [--no-start-wivrn] [--restart-wivrn] [--no-audio]
                                game in the HMD via OpenXR (WiVRn -> Quest); runs across
                                games; starts wivrn-server in the background if none runs;
                                audio goes to the headset while it is connected
  wivrn                         start the WiVRn streaming server (Flatpak, foreground)
  wivrn-restart                 stop wivrn-server, start it in the background (a running
                                  xr reconnects; reconnect the headset app)
  run [opts] -- APP ARGS...     any Vulkan app, one copy per eye
                                  --left-gpu G --right-gpu G (pci:BBBB:BB:DD.F | index | name)
                                  --session S --scale F --snapshot PNG --at N
  clean                         remove stale /dev/shm/vrdual-*
  version                       version, build time and machine of the tools and of each installed layer
  games                         local play log written by xr (never sent anywhere)
  request [GAME] [--open]       ask for a game: GitHub Discussions URLs (search, prefilled new)
  report [GAME] [--open]        how a game runs: prefilled GitHub issue form URL; you submit it
                                  GAME defaults to the last one played; nothing is sent by vrdual
  selftest                      automated verification (~20 s, two small windows); exit 0 = pass

Settings: config file, overridable per run by VRDUAL_<KEY> env (VRDUAL_IPD=0.066 ...).
EOF
}

vrdual_dispatch() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        build|gpus|clean|demo|calib|snapshot|run|config|live|set|save|selftest|help|view|xr|wivrn|wivrn-restart|version|games|request|report|wiggle) "vrdual_$cmd" "$@" ;;
        --version) vrdual_version "$@" ;;
        steam-install) vrdual_steam_install "$@" ;;
        *) say "unknown command: $cmd"; vrdual_help; return 2 ;;
    esac
}

# ------------------------------------------------------------- human entry --
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ $# -gt 0 ]]; then vrdual_dispatch "$@"; exit; fi
    vrdual_help
    PS3=$'\nchoose: '
    select c in build gpus demo calib config snapshot steam-install view wivrn xr request report clean quit; do
        [[ $c == quit || -z $c ]] && exit 0
        case $c in request|report) vrdual_dispatch "$c" --open ;; *) vrdual_dispatch "$c" ;; esac
        break
    done
fi
