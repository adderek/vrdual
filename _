vrdual_help() {
    cat >&2 <<'EOF'
vrdual — dual-GPU per-eye rendering PoC (see README.md)

  build                         compile layer, test app, compositor
  gpus                          list GPUs + narrowest PCIe link on the path to the CPU
  demo                          vrdual-cube on both GPUs + live side-by-side window
  calib                         IPD calibration scene (posts at 0.5..20 m); keys in the window:
                                  Up/Down IPD, PgUp/PgDn near IPD, N near/far on/off,
                                  A anchor, -/= HFOV, W save to profile, H help, S swap
  config [show [APP]|init|path] config file (~/.config/vrdual/vrdual.conf) and effective values
  profiles [list|sync]          game profiles (profiles/*.conf): list and check them, or copy
                                  them where games read them (vrdual install does it too)
  intro off|on|status GAME      rename the game's logo videos away (.orig) or back; listed in its
                                  profile ([game] intro); Steam's file check restores them too
  perf APPID|EXE                what a performance record needs (Proton/DXVK, mode, GPUs, config,
                                  game fps of the last xr session, game config files, mod hints)
  shaders new LOG [CATALOG]     shaders a game met that are not in its shader_catalog (from the
                                  layer log) as catalog lines; with CATALOG, appended there
  live | set KEY VALUE | save   running session: show / change (e.g. "set ipd 64.5mm") / persist
  hunt find [hide|noshift|hud]  find one shader of the running game by bisection (asks questions;
                                  in the headset: controls = hunt, menu + a / b);
                                  hunt MODE LO HI | off sets a key range, hunt shaders lists keys,
                                  hunt rule KEY MODE saves a rule for the running game;
                                  found keys go into shader_rules (docs/tasks/shader-rules.md)
  snapshot [out.png] [frame]    same, but save one paired SBS frame and exit
  shot [out.png] [--hud show|hide|still] [--gif] [--session S]
                                stereo screenshot of the running game: side-by-side png
                                  (default screenshots/<app>_<time>.png); --hud hide: no HUD,
                                  still: HUD at the centre's depth (stands still in a wiggle
                                  GIF); --gif: also the wiggle GIF next to it
  record [out.mp4|DIR] [--seconds N] [--fps N] [--half] [--no-audio] [--session S]
                                stereo video of the running game: side-by-side mp4 (default
                                  5 s, 60 fps, screenshots/<app>_<time>_LR.mp4, game audio)
  wiggle [PNG|DIR...]           SBS screenshots -> wiggle GIFs next to them (default
                                  screenshots/; skips PNGs that already have a .gif)
  install                       install layer + wrapper for Steam / Heroic (Flatpak or native);
                                  prints the launch option:  .../vrdual/run %command%
                                  (old name: steam-install; `vrdual xr` refreshes it at start)
  view [--session S]            SBS window of a running game (finds Flatpak Steam sessions)
  xr [--session S] [--lock world|head] [--no-install] [--no-start-wivrn] [--restart-wivrn] [--no-audio]
                                game in the HMD via OpenXR (WiVRn -> Quest); runs across
                                games; starts wivrn-server in the background if none runs;
                                audio goes to the headset while it is connected
  wivrn                         start the WiVRn streaming server (Flatpak, foreground)
  wivrn-restart                 stop wivrn-server, start it in the background (a running
                                  xr reconnects; reconnect the headset app)
  run [opts] -- APP ARGS...     any Vulkan app, one copy per eye
                                  --left-gpu G --right-gpu G (pci:BBBB:BB:DD.F | index | name)
                                  --session S --scale F --snapshot PNG --at N
  clean                         remove stale /dev/shm/vrdual-*
  version                       version, build time and machine of the tools and of each installed layer
  games                         local play log written by xr (never sent anywhere)
  map [APP]                     controller button maps (gamepad / mouse) per game; bare: editor
                                  map APP|--global MODE BUTTON CODE|none|default sets one
  request [GAME] [--open]       ask for a game: GitHub Discussions URLs (search, prefilled new)
  report [GAME] [--open]        how a game runs: prefilled GitHub issue form URL; you submit it
                                  GAME defaults to the last one played; nothing is sent by vrdual
  selftest                      automated verification (~20 s, two small windows); exit 0 = pass
  ci                            selftest's GPU-free checks only (seconds, no windows; GitHub CI runs it)

Settings: config file, overridable per run by VRDUAL_<KEY> env (VRDUAL_IPD=0.066 ...).
EOF
}

vrdual_dispatch() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        build|gpus|clean|demo|calib|snapshot|run|config|live|set|save|hunt|selftest|ci|help|view|xr|wivrn|wivrn-restart|version|games|request|report|wiggle|shot|map|record|profiles|shaders|perf|intro) "vrdual_$cmd" "$@" ;;
        --version) vrdual_version "$@" ;;
        install|steam-install) vrdual_install "$@" ;;
        *) say "unknown command: $cmd"; vrdual_help; return 2 ;;
    esac
}

