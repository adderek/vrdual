if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ $# -gt 0 ]]; then vrdual_dispatch "$@"; exit; fi
    vrdual_help
    PS3=$'\nchoose: '
    select c in build gpus demo calib config snapshot shot record install view wivrn xr map request report clean quit; do
        [[ $c == quit || -z $c ]] && exit 0
        case $c in request|report) vrdual_dispatch "$c" --open ;; *) vrdual_dispatch "$c" ;; esac
        break
    done
fi
