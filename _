#!/usr/bin/env bash
# vrdual — human front end. Bare `_` = help + interactive menu.
# Implementation lives here; `vrdual` sources this file for the machine contract.
set -euo pipefail
VRDUAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
B="$VRDUAL_ROOT/build"
# Game profiles (profiles/*.conf): tools started from here read the checkout's;
# games read the copy `vrdual install` / `vrdual profiles sync` made.
export VRDUAL_PROFILES="${VRDUAL_PROFILES:-$VRDUAL_ROOT/profiles}"

say() { printf '%s\n' "$*" >&2; }

# ---------------------------------------------------------------- commands --
vrdual_build() { make -C "$VRDUAL_ROOT" -j"$(nproc)" all lib32 >&2; }

# Lists display-class PCI GPUs and the narrowest link on the path to the CPU
# (the GPU's own slot always claims x16; the chipset uplink is what limits).
vrdual_gpus() {
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [[ "$(cat "$dev/class")" == 0x03* ]] || continue
        local bdf path n minw=99 mins=99 node chipset=0
        bdf=$(basename "$dev")
        path=$(realpath "$dev")
        n=0
        for node in $(echo "${path#/sys/devices/}" | tr / ' '); do
            [[ $node == pci* ]] && continue
            local p=/sys/bus/pci/devices/$node w s
            [[ -r $p/max_link_width ]] || continue
            w=$(cat "$p/max_link_width"); s=$(cut -d' ' -f1 "$p/max_link_speed")
            (( w < minw )) && minw=$w
            awk "BEGIN{exit !($s < $mins)}" && mins=$s
            n=$((n + 1))
        done
        # >2 bridge hops between root complex and GPU = behind a switch (chipset on AM4/AM5).
        (( n > 4 )) && chipset=1
        printf '%s\t%s\tGen-speed=%sGT/s\tx%s\tbridges=%s\t%s\n' "$bdf" \
            "$(lspci -s "$bdf" | cut -d: -f3- | sed 's/^ //' | cut -c1-60)" "$mins" "$minw" "$n" \
            "$( ((chipset)) && echo 'behind-switch(chipset?)' || echo 'cpu-direct')"
    done
}

# With two or more display-class PCI devices: "pci:ADDR" of the first one with
# no connected monitor (DRM connector status), else "default".
headless_gpu() {
    local d n=0 pick=""
    for d in /sys/bus/pci/devices/*; do
        [[ $(cat "$d/class" 2>/dev/null) == 0x03* ]] || continue
        n=$((n + 1))
        [[ -z $pick ]] && ! grep -qx connected "$d"/drm/card*/card*-*/status 2>/dev/null && pick=${d##*/}
    done
    if ((n >= 2)) && [[ -n $pick ]]; then echo "pci:$pick"; else echo default; fi
}

vrdual_clean() { rm -f /dev/shm/vrdual-* "$FLATPAK_SHM"/vrdual-* "$HEROIC_SHM"/vrdual-* 2>/dev/null; say "removed vrdual-* from /dev/shm (and Flatpak Steam's, Heroic's)"; }

# vrdual_run [--left-gpu G] [--right-gpu G] [--session S] [--snapshot PNG --at N] -- APP ARGS...
# Starts the compositor and two copies of APP (one per eye/GPU). All VRDUAL_*
# variables in the environment (IPD, ANCHOR, ...) are passed through.
vrdual_run() {
    local lg="" rg=""  # empty = left_gpu/right_gpu from the config file
    local session="${VRDUAL_SESSION:-default}" snapshot="" at=120 scale="${VRDUAL_SCALE:-0}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --left-gpu) lg=$2; shift 2 ;;
            --right-gpu) rg=$2; shift 2 ;;
            --session) session=$2; shift 2 ;;
            --snapshot) snapshot=$2; shift 2 ;;
            --at) at=$2; shift 2 ;;
            --scale) scale=$2; shift 2 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    [[ $# -gt 0 ]] || { say "run: missing app command"; return 2; }
    [[ -x $B/libVkLayer_vrdual.so || -f $B/libVkLayer_vrdual.so ]] || vrdual_build
    rm -f /dev/shm/vrdual-"$session"-*
    local -a envs=(VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION="$session")
    local pids=()
    env "${envs[@]}" VRDUAL_EYE=left ${lg:+VRDUAL_GPU="$lg"} "$@" >&2 & pids+=($!)
    env "${envs[@]}" VRDUAL_EYE=right ${rg:+VRDUAL_GPU="$rg"} "$@" >&2 & pids+=($!)
    local rc=0
    if [[ -n $snapshot ]]; then
        "$B/vrdual-compositor" --session "$session" --snapshot "$snapshot" --at "$at" || rc=$?
        kill "${pids[@]}" 2>/dev/null || true
        echo "$snapshot"
    else
        "$B/vrdual-compositor" --session "$session" --scale "$scale" || rc=$?
        kill "${pids[@]}" 2>/dev/null || true
    fi
    wait 2>/dev/null || true
    rm -f /dev/shm/vrdual-"$session"-*
    return $rc
}

vrdual_demo() { vrdual_run "$@" -- "$B/vrdual-cube"; }

# Calibration: static posts at 0.5/1/2/5/20 m, compositor keys change IPD live.
vrdual_calib() { vrdual_run "$@" -- "$B/vrdual-cube" --scene calib; }

# Config file + live control of a running session (thin wrappers on vrdual-ctl).
vrdual_config() { "$B/vrdual-ctl" "${1:-show}" "${@:2}"; }
vrdual_live() { pick_shm "$@"; "$B/vrdual-ctl" live "$@"; }
vrdual_set() { pick_shm "$@"; "$B/vrdual-ctl" set "$@"; }
vrdual_save() { pick_shm "$@"; "$B/vrdual-ctl" save "$@" && config_sync; }

# cp + mv: a game starting meanwhile reads the old or the new file, never half of it.
copy_atomic() { cp "$1" "$2.tmp.$$" && mv -f "$2.tmp.$$" "$2"; }

# Profiles DIR: the checkout's profiles/*.conf into DIR/profiles (each file
# replaced whole, stale ones removed). Silent when nothing changed.
profiles_copy() {
    local dst=$1/profiles f n=0
    mkdir -p "$dst"
    for f in "$VRDUAL_ROOT"/profiles/*.conf; do
        cmp -s "$f" "$dst/${f##*/}" || { copy_atomic "$f" "$dst/${f##*/}"; n=$((n + 1)); }
    done
    for f in "$dst"/*.conf; do
        [[ -f $f && ! -f $VRDUAL_ROOT/profiles/${f##*/} ]] && { rm -f "$f"; n=$((n + 1)); }
    done
    ((n == 0)) || say "profiles: $n file(s) updated in $dst"
}

# `profiles [list]`: the checkout's profiles, checked (file, exe, steam id,
# keys; exit 1 on an unknown key). `profiles sync`: copy them where games read
# them (every vrdual install, plus the host default ~/.local/share/vrdual).
vrdual_profiles() {
    case ${1:-list} in
        list) "$B/vrdual-ctl" profiles "$VRDUAL_ROOT/profiles" ;;
        sync)
            "$B/vrdual-ctl" profiles "$VRDUAL_ROOT/profiles" >/dev/null || return 1
            local d
            for d in "$STEAM_FLATPAK/vrdual" "${XDG_DATA_HOME:-$HOME/.local/share}/vrdual"; do
                [[ -f $d/run || $d == "${XDG_DATA_HOME:-$HOME/.local/share}/vrdual" ]] && profiles_copy "$d"
            done ;;
        *) say "usage: vrdual profiles [list|sync]"; return 2 ;;
    esac
}

# Shader catalog (shader_catalog, docs/CONFIG.md). `shaders new LOG [CATALOG]`:
# the "not in catalog" lines of a layer log (Proton log, game.log) as catalog
# lines "KEY  STATE  new DATE" on stdout, each key once. With CATALOG (created
# if missing) only keys not in it yet, appended there, and its "# translator"
# line set to the log's (DXVK / vkd3d / Zink version the keys belong to).
vrdual_shaders() {
    [[ ${1:-} == new && -n ${2:-} && $# -le 3 ]] || { say "usage: vrdual shaders new LOG [CATALOG]"; return 2; }
    local log=$2 cat=${3:-} tr was new n
    [[ -r $log ]] || { say "cannot read $log"; return 1; }
    tr=$(grep -oP 'shader_catalog: .*, translator \K.*' "$log" | tail -1) || true
    new=$(grep -oP 'shader \K[0-9a-f]{16}: not in catalog \(.*\)' "$log" |
        awk -v d="$(date +%F)" -v cat="$cat" 'BEGIN { if (cat != "") while ((getline l < cat) > 0) { split(l, f, " "); have[f[1]] = 1 } }
            { k = substr($1, 1, 16); if (have[k]++) next; st = $0; sub(/^[^(]*\(/, "", st); sub(/\)$/, "", st); printf "%s  %s  new %s\n", k, st, d }') || true
    n=$(grep -c . <<<"$new") || true
    [[ -n $new ]] && printf '%s\n' "$new"
    if [[ -z $cat ]]; then
        say "$n new key(s)${tr:+, translator $tr}"
        return 0
    fi
    [[ -f $cat ]] || printf '# shader catalog: KEY  STATE  what it draws (shader_catalog in docs/CONFIG.md)\n' >"$cat" || return 1
    was=$(grep -oP '^# translator \K.*' "$cat" | tail -1) || true
    if [[ -n $tr && $tr != "$was" ]]; then
        [[ -n $was ]] && say "translator changed: $was -> $tr (keys from $was may be gone; the summary line counts them as unseen)"
        { grep -v '^# translator ' "$cat"; printf '# translator %s\n' "$tr"; } >"$cat.new.$$" && mv -f "$cat.new.$$" "$cat"
    fi
    [[ -n $new ]] && printf '%s\n' "$new" >>"$cat"
    say "$n new key(s) -> $cat"
}

# Flatpak Steam game APPID: "NAME<TAB>INSTALL_DIR<TAB>LIBRARY" (exit 1 if not installed).
steam_game() {
    local root="$STEAM_FLATPAK/.local/share/Steam" lib m
    for lib in $(grep -oP '"path"\s+"\K[^"]+' "$root/steamapps/libraryfolders.vdf" 2>/dev/null) "$root"; do
        m=$lib/steamapps/appmanifest_$1.acf
        [[ -f $m ]] || continue
        printf '%s\t%s\t%s\n' "$(grep -oP '"name"\s+"\K[^"]+' "$m" | head -1)" "$lib/steamapps/common/$(grep -oP '"installdir"\s+"\K[^"]+' "$m" | head -1)" "$lib"
        return 0
    done
    return 1
}

# Intro videos (TODO 16): `intro off|on|status GAME [--dir DIR]`. GAME = a
# profile (file name, exe or Steam appid) whose [game] intro lists globs
# relative to the install dir (Flatpak Steam, or --dir). off renames each
# match to NAME.orig, on renames back; prints "on|off<TAB>PATH" per file.
# Steam's "verify integrity of game files" restores them as well.
vrdual_intro() {
    local act=${1:-} game=${2:-} dir="" f p prof="" pats steam
    [[ ${3:-} == --dir && -n ${4:-} ]] && dir=$4
    [[ $act =~ ^(off|on|status)$ && -n $game && ( $# -eq 2 || -n $dir ) ]] || { say "usage: vrdual intro off|on|status GAME [--dir INSTALL_DIR]"; return 2; }
    local lg=${game,,}
    for f in "$VRDUAL_ROOT"/profiles/*.conf; do
        p=$(awk -F= '/^\[/ { s = $0 } s == "[game]" && /=/ { k = $1; gsub(/[ \t]/, "", k); v = $2; gsub(/^[ \t]+|[ \t]+$/, "", v); print k "=" v }' "$f")
        local base=${f##*/}; base=${base%.conf}
        local exes=,$(sed -n 's/^exe=//p' <<<"$p" | tr -d ' ' | tr 'A-Z' 'a-z'),
        if [[ ${base,,} == "$lg" || $exes == *",$lg,"* || $(sed -n 's/^steam=//p' <<<"$p") == "$game" ]]; then prof=$f; break; fi
    done
    [[ -n $prof ]] || { say "no profile for '$game' in $VRDUAL_ROOT/profiles"; return 1; }
    pats=$(sed -n 's/^intro=//p' <<<"$p" | tr ',' ' ')
    [[ -n $pats ]] || { say "${prof##*/}: no intro videos listed ([game] intro = GLOB, ...)"; return 1; }
    steam=$(sed -n 's/^steam=//p' <<<"$p")
    if [[ -z $dir ]]; then
        [[ -n $steam ]] && dir=$(steam_game "$steam" | cut -f2) || true
        [[ -d $dir ]] || { say "${prof##*/}: game not found in Flatpak Steam${steam:+ (appid $steam)}; give --dir INSTALL_DIR"; return 1; }
    fi
    local n=0 pat o
    local -a pl
    read -ra pl <<<"$pats"  # not `for pat in $pats`: that would glob against the current dir
    shopt -s nullglob
    for pat in "${pl[@]}"; do
        for f in "$dir"/$pat "$dir"/$pat.orig; do
            [[ -f $f ]] || continue
            o=$f
            if [[ $act == off && $f != *.orig ]]; then mv -n -- "$f" "$f.orig" && o=$f.orig
            elif [[ $act == on && $f == *.orig ]]; then mv -n -- "$f" "${f%.orig}" && o=${f%.orig}; fi
            [[ $o == *.orig ]] && printf 'off\t%s\n' "${o%.orig}" || printf 'on\t%s\n' "$o"
            n=$((n + 1))
        done
    done
    shopt -u nullglob
    (( n )) || { say "no file matches $pats in $dir"; return 1; }
}

# Performance record helper (TODO 19). `perf GAME` (Steam appid or exe name):
# what a perf entry needs that the machine knows, as "key<TAB>value" lines:
# game, logs, Proton / DXVK / vkd3d, vrdual mode and GPUs, non-default
# config, the layer's export / memory sync lines, the game fps of the game's
# last `vrdual xr` session, the game's own config files (Proton prefix,
# install dir; newest first) and mod hints. The scene and the in-game
# options changed come from the player; the baseline is a run with stereo = 0.
vrdual_perf() {
    local game=${1:-} root="$STEAM_FLATPAK/.local/share/Steam" appid="" exe="" log="" name="" lib="" dir="" f
    [[ -n $game && $# -eq 1 ]] || { say "usage: vrdual perf APPID|EXE"; return 2; }
    if [[ $game =~ ^[0-9]+$ ]]; then
        appid=$game
        [[ -f $STEAM_FLATPAK/steam-$appid.log ]] && log=$STEAM_FLATPAK/steam-$appid.log
    else
        exe=$game
        # newest Proton log whose layer lines name this exe
        log=$(grep -lF "exe='" "$STEAM_FLATPAK"/steam-*.log 2>/dev/null | xargs -r grep -liF -- " $exe'" 2>/dev/null | xargs -r ls -t 2>/dev/null | head -1) || true
        [[ -n $log ]] && { appid=${log##*/steam-}; appid=${appid%.log}; }
    fi
    [[ -n $log || -n $appid ]] || { say "no Proton log for '$game' in $STEAM_FLATPAK (native games: not supported yet)"; return 1; }
    [[ -n $appid ]] && IFS=$'\t' read -r name dir lib < <(steam_game "$appid") || true
    [[ -z $exe && -n $log ]] && exe=$(grep -oP "^\[vrdual:[^]]*\] app='[^']*' exe='\S+ \K[^']+(?=' profile=)" "$log" | tail -1)
    printf 'game\t%s\nappid\t%s\nexe\t%s\n' "${name:-?}" "${appid:-?}" "${exe:-?}"
    if [[ -n $log ]]; then
        printf 'log\t%s\t%s\n' "$log" "$(date -r "$log" '+%F %T')"
        local L=$(grep -E '^Proton: |DXVK: v|vkd3d-proton|^\[vrdual' "$log")
        awk -F'\t' 'BEGIN { OFS = "\t" }
            /^Proton: / && !p++ { print "proton", $0; sub(/^proton\t/, "") }
            /DXVK: v/ && !d++ { sub(/.*DXVK: /, ""); print "dxvk", $0 }
            /vkd3d-proton/ && !v++ { sub(/^[^:]*: */, ""); print "vkd3d", $0 }' <<<"$L" | sed 's/^proton\tProton: /proton\t/'
        local V=$(grep -E '^\[vrdual:(LR|L|R)\]' <<<"$L")
        sed -nE 's/^\[vrdual:[^]]*\] vrdual (.*)$/vrdual_layer\t\1/p' <<<"$V" | tail -1
        if grep -q 'mirror: twin device' <<<"$V"; then printf 'mode\tmirror\n'
        elif grep -q 'alternate' <<<"$V"; then printf 'mode\tsingle GPU (alternate eyes)\n'
        elif grep -qE '^\[vrdual:[LR]\]' <<<"$V"; then printf 'mode\tper-eye processes\n'
        else printf 'mode\t? (no vrdual layer lines)\n'; fi
        sed -nE 's/^\[vrdual:[^]]*\] (device created on .*|mirror: twin device on .*\(pci [^)]*\)).*/gpu\t\1/p' <<<"$V" | awk '!s[$0]++'
        sed -nE 's/^\[vrdual:[^]]*\] exporting ([0-9]+x[0-9]+).*/resolution\t\1/p' <<<"$V" | tail -1
        sed -nE "s/^\[vrdual:[^]]*\] app='[^']*' exe='[^']*' profile='([^']*)'.*/profile\t\1/p" <<<"$V" | tail -1
        sed -nE 's/^\[vrdual:[^]]*\] (export: .*)/export\t\1/p' <<<"$V" | tail -1
        sed -nE 's/^\[vrdual:[^]]*\] mirror: (memory sync .*)/memory_sync\t\1/p' <<<"$V" | tail -1
    fi
    [[ -n $exe && $exe != "?" ]] && "$B/vrdual-ctl" show "$exe" 2>/dev/null | awk '!/# default$/ { k = $1; v = $0; sub(/^[^ ]+ +/, "", v); src = v; sub(/ *# .*/, "", v); sub(/.*# /, "", src); print "config\t" k "\t" v "\t" src }' || true
    # game fps of the last vrdual xr session of this exe (stats lines, frames
    # arriving), over the rotated logs oldest first
    local xl=${XDG_STATE_HOME:-$HOME/.local/state}/vrdual/xr.log
    [[ -n $exe ]] && { cat "$xl".{4,3,2,1} "$xl" 2>/dev/null || true; } | awk -v app="$exe" -F'\t' '
        index($0, "[xr] app '\''" app "'\''") { start = substr($0, 1, 19); n = 0; s = 0; mx = 0; last = ""; on = 1; next }
        index($0, "[xr] app '\''") { on = 0 }
        on && / new game frames \(/ {
            f = $0; sub(/.* new game frames \(/, "", f); f += 0
            if (f > 0) { n++; s += f; if (f > mx) mx = f; last = substr($0, 1, 19) }
            line = $0 }
        END { if (start == "") print "xr_session\tnone in xr.log (rotated out, or not played with vrdual xr)"
              if (start != "") { printf "xr_session\t%s .. %s\n", start, last == "" ? "?" : last
                  if (n) printf "xr_game_fps\t%.1f avg, %.1f max over %d stats lines (5 s each)\n", s / n, mx, n
                  if (line != "") { sub(/^[^[]*/, "", line); print "xr_stats\t" line } } }'
    # the game's own settings: Proton prefix user dirs and the install dir
    local pfx=$lib/steamapps/compatdata/$appid/pfx/drive_c/users/steamuser
    # (prefix: what the game wrote = the player's settings; install dir: defaults, mod configs)
    lst() { sort -rn | head -"$2" | while IFS=$'\t' read -r t f; do printf 'game_config\t%s\t%s\t%s\n' "$1" "$f" "$(date -d "@${t%.*}" '+%F %T')"; done; }
    [[ -n $appid && -d $pfx ]] && find -H "$pfx/Documents" "$pfx/AppData" "$pfx/Saved Games" -maxdepth 6 -type f \
        \( -iname '*.ini' -o -iname '*.cfg' -o -iname '*.xml' -o -iname '*.json' -o -iname '*.conf' \) -size -1024k -printf '%T@\t%p\n' 2>/dev/null | lst prefix 20 || true
    [[ -n $dir && -d $dir ]] && find "$dir" -maxdepth 3 -type f \( -iname '*.ini' -o -iname '*.cfg' \) -size -1024k -printf '%T@\t%p\n' 2>/dev/null | lst install 10 || true
    # mods: mod folders, loaders, wrapper DLLs in the game dir (Proton's DXVK is not there)
    [[ -n $dir && -d $dir ]] && find "$dir" -maxdepth 3 \( -type d \( -iname mods -o -iname mod -o -iname plugins -o -iname bepinex -o -iname 'reshade*' -o -iname enbseries \) \
        -o -type f \( -iname dinput8.dll -o -iname dxgi.dll -o -iname d3d9.dll -o -iname d3d11.dll -o -iname version.dll -o -iname winmm.dll -o -iname '*.asi' -o -iname 'reshade*.ini' \) \) \
        -printf 'mod_hint\t%p\n' 2>/dev/null | head -20 || true
    say "player: add the scene (level, area), in-game options changed and a baseline run (stereo = 0); see TODO 19"
}

# Games in Flatpak Steam / Heroic read the copy `vrdual install` made, not the
# host config: refresh the copies after a write (they apply at the next start).
config_sync() {
    local c d
    c=$("$B/vrdual-ctl" path)
    [[ -f $c ]] || return 0
    for d in "$STEAM_FLATPAK/vrdual" "$HOME/.local/share/vrdual"; do
        [[ -f $d/run ]] || continue
        cmp -s "$c" "$d/vrdual.conf" && continue
        copy_atomic "$c" "$d/vrdual.conf" && say "copied $c -> $d/vrdual.conf (the game reads that one)"
    done
    return 0
}

# Shader hunt (docs/tasks/shader-rules.md). `hunt [off | MODE LO HI]` and
# `hunt shaders` go straight to vrdual-ctl; `hunt find [MODE]` bisects over
# the session's vertex shader keys: half of them get MODE (default hide), you
# answer whether the thing you look for changed (vrdual-ctl hunt find; in
# the headset: controls = hunt in vrdual-xr).
vrdual_hunt() {
    pick_shm "$@"
    local -a ses=()
    [[ -n ${VRDUAL_SESSION:-} ]] && ses=(--session "$VRDUAL_SESSION")
    local a prev=""
    for a; do [[ $prev == --session ]] && ses=(--session "$a"); prev=$a; done
    case ${1:-} in
        shaders) "$B/vrdual-ctl" "${ses[@]}" shaders; return ;;
        rule) "$B/vrdual-ctl" "$@" && config_sync; return ;;
        find) ;;
        *) "$B/vrdual-ctl" hunt "$@"; return ;;
    esac
    local mode=hide
    case ${2:-} in hide|noshift|hud) mode=$2 ;; esac
    # one bisection for the terminal and the headset (vrdual-xr input = hunt): common/vrdual_hunt.hpp
    "$B/vrdual-ctl" "${ses[@]}" hunt find "$mode" || return
    config_sync
}

# ------------------------------------------------------------ steam / HMD --
STEAM_FLATPAK="$HOME/.var/app/com.valvesoftware.Steam"
FLATPAK_SHM="/run/user/$(id -u)/.flatpak/com.valvesoftware.Steam/dev-shm"
# Heroic (Flatpak, per-app-dev-shm) runs Epic/GOG games with the same wrapper
HEROIC_SHM="/run/user/$(id -u)/.flatpak/com.heroicgameslauncher.hgl/dev-shm"

# Frame files and control block of a game inside Flatpak Steam (or Heroic)
# live in its private /dev/shm. Exports VRDUAL_SHM_DIR when that is where
# session S is (or will be: Flatpak Steam runs and /dev/shm has nothing for S).
pick_shm() {
    [[ -n ${VRDUAL_SHM_DIR:-} ]] && return 0
    local s="${VRDUAL_SESSION:-default}" a
    for a in "$@"; do [[ ${prev:-} == --session ]] && s=$a; prev=$a; done
    unset prev
    # Several dirs can hold session S (a stale one from the last game): take
    # the one with the newest frame (else control block).
    local d best="" bt=0 t f
    for d in /dev/shm "$HEROIC_SHM" "$FLATPAK_SHM"; do
        for f in "$d/vrdual-$s-0" "$d/vrdual-$s-ctl"; do
            [[ -e $f ]] || continue
            t=$(stat -c %Y "$f" 2>/dev/null) || continue
            (( t > bt )) && { bt=$t; best=$d; }
            break
        done
    done
    if [[ -n $best ]]; then
        [[ $best == /dev/shm ]] && return 0
        export VRDUAL_SHM_DIR=$best
        if [[ $best == "$HEROIC_SHM" ]]; then say "session '$s': using Flatpak Heroic's /dev/shm ($HEROIC_SHM)"
        else say "session '$s': using Flatpak Steam's /dev/shm ($FLATPAK_SHM)"; fi
    elif [[ -d $FLATPAK_SHM/ ]]; then
        export VRDUAL_SHM_DIR=$FLATPAK_SHM
        say "session '$s': using Flatpak Steam's /dev/shm ($FLATPAK_SHM)"
    fi
}

# Installs the layer (32 + 64 bit) and a launch wrapper where Steam games can
# see them; prints the Steam launch option (stdout).
# Layer + wrapper where games load them (Flatpak Steam's dir, else
# ~/.local/share/vrdual), plus the config copy. --quiet (vrdual xr runs it at
# every start): no launch option on stdout, say only what changed.
vrdual_install() {
    local quiet=0
    [[ ${1:-} == --quiet ]] && quiet=1
    make -s -C "$VRDUAL_ROOT" -j"$(nproc)" install-build >&2 || return 1
    local host inside first=0 changed=0
    if [[ -d $STEAM_FLATPAK ]]; then
        host=$STEAM_FLATPAK/vrdual; inside=$HOME/vrdual
    else
        host=$HOME/.local/share/vrdual; inside=$host
    fi
    [[ -f $host/run ]] || first=1
    cmp -s "$B/libVkLayer_vrdual.so" "$host/layer/libVkLayer_vrdual64.so" 2>/dev/null && cmp -s "$B/lib32/libVkLayer_vrdual.so" "$host/layer/libVkLayer_vrdual32.so" 2>/dev/null || changed=1
    mkdir -p "$host/layer"
    # new inode (cp + mv): running games keep their mapping of the old file
    cp "$B/libVkLayer_vrdual.so" "$host/layer/.new64" && mv -f "$host/layer/.new64" "$host/layer/libVkLayer_vrdual64.so"
    cp "$B/lib32/libVkLayer_vrdual.so" "$host/layer/.new32" && mv -f "$host/layer/.new32" "$host/layer/libVkLayer_vrdual32.so"
    local bits
    for bits in 32 64; do
        sed -e "s|\"./libVkLayer_vrdual.so\"|\"./libVkLayer_vrdual$bits.so\",\n        \"library_arch\": \"$bits\"|" \
            -e 's|"file_format_version": "1.2.0"|"file_format_version": "1.2.1"|' \
            "$VRDUAL_ROOT/layer/VkLayer_vrdual.json.in" >"$host/layer/VkLayer_vrdual$bits.json"
    done
    cat >"$host/run" <<'WRAP'
#!/bin/sh
# vrdual Steam wrapper (installed by `vrdual install`).
# Steam > game > Properties > Launch options:   <path of this file> %command%
# One process, the game sees one GPU, the other renders the second eye.
# OpenGL games go through Zink (GL on Vulkan) so the layer can see them.
d=$(dirname "$(readlink -f "$0")")
export VK_ADD_LAYER_PATH="$d/layer${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"
export VK_INSTANCE_LAYERS="VK_LAYER_VRDUAL_stereo${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}"
export VRDUAL_EYE="${VRDUAL_EYE:-both}"
export MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-zink}"
# glvnd would pick NVIDIA's own GL (bypasses Vulkan and the layer); force Mesa.
export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-mesa}"
# Host config copy (vrdual install); Proton games log to ~/.var/app/…Steam/steam-<appid>.log
[ -f "$d/vrdual.conf" ] && export VRDUAL_CONFIG="${VRDUAL_CONFIG:-$d/vrdual.conf}"
# Game profiles copied by vrdual install / vrdual profiles sync
[ -d "$d/profiles" ] && export VRDUAL_PROFILES="${VRDUAL_PROFILES:-$d/profiles}"
export PROTON_LOG="${PROTON_LOG:-1}"
# Heroic + umu: Proton names its log steam-0-….log for every game; one dir per game
if [ -n "$HEROIC_APP_NAME" ] && [ -n "$PROTON_LOG_DIR" ]; then
    export PROTON_LOG_DIR="$PROTON_LOG_DIR/vrdual-$HEROIC_APP_NAME"
    mkdir -p "$PROTON_LOG_DIR"
fi
# gamescope around a Flatpak launcher (Heroic + umu): the container start
# resets DISPLAY to the desktop's; umu-shim (patched by vrdual install) puts
# gamescope's back from VRDUAL_DISPLAY inside the container.
[ -n "$GAMESCOPE_WAYLAND_DISPLAY" ] && export VRDUAL_DISPLAY="${VRDUAL_DISPLAY:-$DISPLAY}"
# native games (no Proton): stderr incl. the layer log -> game.log next to this
case "$*" in *proton*) exec "$@" ;; *) exec "$@" 2>"$d/game.log" ;; esac
WRAP
    chmod +x "$host/run"
    profiles_copy "$host"
    umu_shim_patch
    if [[ -f $(vrdual-config-path) ]]; then
        cmp -s "$(vrdual-config-path)" "$host/vrdual.conf" || { copy_atomic "$(vrdual-config-path)" "$host/vrdual.conf"; say "copied $(vrdual-config-path) -> $host/vrdual.conf (the game reads that one)"; }
    else
        rm -f "$host/vrdual.conf"
    fi
    if ((quiet)); then
        ((first)) && say "installed to $host; Steam > game > Properties > Launch options: $inside/run %command%"
        ((changed && !first)) && say "updated the layer games load ($host); games already running keep the old one"
        return 0
    fi
    say "installed to $host"
    say "Steam > game > Properties > Launch options:"
    echo "$inside/run %command%"
}
vrdual_steam_install() { vrdual_install "$@"; }  # old name
vrdual-config-path() { "$B/vrdual-ctl" path; }

# umu (Heroic, Lutris) runs this shim inside the Steam Runtime container. umu
# writes it only when missing, so the inserted line stays; it acts only when
# the vrdual wrapper ran inside gamescope (VRDUAL_DISPLAY set).
UMU_SHIM="$HOME/.local/share/umu/umu-shim"
umu_shim_patch() {
    [[ -f $UMU_SHIM ]] || return 0
    grep -q VRDUAL_DISPLAY "$UMU_SHIM" && return 0
    sed -i '1a # vrdual: gamescope display, reset by the Flatpak container start\n[ -n "${VRDUAL_DISPLAY}" ] \&\& { export DISPLAY="${VRDUAL_DISPLAY}"; unset WAYLAND_DISPLAY; }' "$UMU_SHIM"
    say "patched $UMU_SHIM (gamescope DISPLAY for umu games)"
}

# Warns when the layer or config copy Steam games load differs from build/ or
# the host config (forgot `vrdual install`: the game runs the old one).
steam_layer_check() {
    local d c
    c=$(vrdual-config-path)
    for d in "$STEAM_FLATPAK/vrdual" "$HOME/.local/share/vrdual"; do
        [[ -f $d/layer/libVkLayer_vrdual64.so ]] || continue
        cmp -s "$d/layer/libVkLayer_vrdual64.so" "$B/libVkLayer_vrdual.so" || say "warning: $d/layer differs from build/ (run: vrdual install)"
        if [[ -f $c ]] && ! cmp -s "$c" "$d/vrdual.conf"; then say "warning: $d/vrdual.conf differs from $c (run: vrdual install)"; fi
        diff -rq "$VRDUAL_ROOT/profiles" "$d/profiles" >/dev/null 2>&1 || say "warning: $d/profiles differs from profiles/ (run: vrdual profiles sync)"
    done
    return 0
}

# Build identity (tools/build_info.sh) of what would run: source tree, tools,
# build/ layers and the copies games load (vrdual install). stdout = data:
# "<what>\t<build info>", "-" when missing.
vrdual_version() {
    local f d i
    printf 'source\t%s\n' "$("$VRDUAL_ROOT/tools/build_info.sh" | sed 's/, built .*//') (now)"
    printf 'tools\t%s\n' "$("$B/vrdual-ctl" --version 2>/dev/null || echo -)"
    for f in "$B/libVkLayer_vrdual.so" "$B/lib32/libVkLayer_vrdual.so" \
        "$STEAM_FLATPAK"/vrdual/layer/libVkLayer_vrdual{64,32}.so "$HOME"/.local/share/vrdual/layer/libVkLayer_vrdual{64,32}.so; do
        d=${f/#$HOME/\~}
        [[ -f $f ]] || { [[ $f == "$B"/* ]] && printf '%s\t-\n' "$d"; continue; }
        printf '%s\t%s\n' "$d" "$(layer_info "$f")"
    done
}

layer_info() {
    local i
    i=$(strings -a "$1" | grep -m1 '^vrdual .*, built ' || true)  # grep -m1: SIGPIPE for strings, pipefail
    echo "${i:-(older than build info)}"
}

# SBS window for a running session (also finds games inside Flatpak Steam).
vrdual_view() { pick_shm "$@"; "$B/vrdual-compositor" "$@"; }

# HMD output through OpenXR. Without an active runtime, uses WiVRn's Flatpak.
# WiVRn as runtime needs wivrn-server: started in the background when none
# runs (log: $XDG_RUNTIME_DIR/vrdual-wivrn.log); --no-start-wivrn refuses instead,
# --restart-wivrn stops a running one first (headset stuck on WiVRn's app list).
# Audio follows the headset (xr_audio_follow); --no-audio leaves outputs alone.
vrdual_xr() {
    local a start=1 restart=0 audio=1 install=1 args=()
    for a in "$@"; do
        case $a in --no-install) install=0 ;; --no-start-wivrn) start=0 ;; --restart-wivrn) restart=1 ;; --no-audio) audio=0 ;; *) args+=("$a") ;; esac
    done
    set -- "${args[@]}"
    # follows the game between host /dev/shm, Flatpak Steam's and Heroic's,
    # across games (Heroic's dir exists only while Heroic runs)
    if [[ -z ${VRDUAL_SHM_DIR:-} && -d $STEAM_FLATPAK ]]; then export VRDUAL_SHM_DIR="/dev/shm:$FLATPAK_SHM:$HEROIC_SHM"; fi
    # the copy games load follows build/ and the config (--no-install: leave it)
    if ((install)); then vrdual_install --quiet || { say "warning: install failed, games may load an old layer"; steam_layer_check; }
    else steam_layer_check; fi
    # checked again by vrdual-xr at each game start (the conf may be edited meanwhile)
    [[ -f $STEAM_FLATPAK/vrdual/vrdual.conf ]] && export VRDUAL_CONF_COPY="$STEAM_FLATPAK/vrdual/vrdual.conf"
    if [[ -z ${XR_RUNTIME_JSON:-} && ! -e ${XDG_CONFIG_HOME:-$HOME/.config}/openxr/1/active_runtime.json ]]; then
        local w
        w=$(flatpak info --show-location io.github.wivrn.wivrn 2>/dev/null) && export XR_RUNTIME_JSON=$w/files/share/openxr/1/openxr_wivrn.json
    fi
    local rt=${XR_RUNTIME_JSON:-$(readlink -f "${XDG_CONFIG_HOME:-$HOME/.config}/openxr/1/active_runtime.json" 2>/dev/null)}
    if [[ $rt == *wivrn* ]] && ((restart)); then
        vrdual_wivrn-restart || return 1
    elif [[ $rt == *wivrn* ]] && ! pgrep -x wivrn-server >/dev/null; then
        if ((!start)); then
            say "error: wivrn-server is not running. Start it first: 'vrdual wivrn' in another terminal, or drop --no-start-wivrn"
            return 1
        fi
        wivrn_bg_start || return 1
    fi
    if [[ $rt == *wivrn* ]] && ((audio)) && command -v pactl >/dev/null; then
        local state rc=0 ap
        state=$(mktemp)
        xr_audio_follow "$state" & ap=$!
        trap ':' INT TERM  # Ctrl-C ends vrdual-xr; the restore below still runs
        "$B/vrdual-xr" "$@" || rc=$?
        trap - INT TERM
        kill $ap 2>/dev/null || true
        wait $ap 2>/dev/null || true  # killed: 143, and set -e
        xr_audio_restore "$state"
        rm -f "$state"
        return $rc
    fi
    "$B/vrdual-xr" "$@"
}

# Game audio to the headset. WiVRn's sink appears when the headset connects;
# at that moment it becomes the default output (streams following the default
# move with it). Only on appearance: a default changed by hand later stays.
# $1: file that keeps the output to restore.
xr_audio_follow() {
    local had=0 now prev
    while :; do
        now=0
        pactl list short sinks 2>/dev/null | cut -f2 | grep -qx wivrn.sink && now=1
        if ((now && !had)); then
            prev=$(pactl get-default-sink 2>/dev/null)
            if [[ -n $prev && $prev != wivrn.sink ]] && pactl set-default-sink wivrn.sink; then
                echo "$prev" >"$1"
                say "audio: default output -> wivrn.sink (headset), was $prev"
            fi
        fi
        had=$now
        sleep "${VRDUAL_AUDIO_POLL:-2}"
    done
}

# Puts the output from before back, if the headset's is still the default.
xr_audio_restore() {
    local prev
    prev=$(cat "$1" 2>/dev/null)
    [[ -n $prev && $(pactl get-default-sink 2>/dev/null) == wivrn.sink ]] || return 0
    pactl set-default-sink "$prev" && say "audio: default output -> $prev"
}

wivrn_bg_start() {
    local log=${XDG_RUNTIME_DIR:-/tmp}/vrdual-wivrn.log i
    say "starting wivrn-server in the background (log: $log)"
    (vrdual_wivrn >"$log" 2>&1 &)  # its lock: a parallel start loses and exits, we wait for the winner
    for i in $(seq 20); do pgrep -x wivrn-server >/dev/null && break; sleep 0.5; done
    pgrep -x wivrn-server >/dev/null || { say "error: wivrn-server did not start, see $log"; tail -5 "$log" >&2; return 1; }
    sleep 1  # IPC socket
}

# Stops wivrn-server (ours or not) and starts it again in the background. A
# running `vrdual xr` loses its session and reconnects by itself; the headset
# app has to connect again (its "Connect" button, or autoconnect).
vrdual_wivrn-restart() {
    local i lock=${XDG_RUNTIME_DIR:-/tmp}/vrdual-wivrn.lock
    if pgrep -x wivrn-server >/dev/null; then
        say "stopping wivrn-server (pid $(pgrep -x wivrn-server | paste -sd' '))"
        pkill -x wivrn-server
        for i in $(seq 20); do pgrep -x wivrn-server >/dev/null || break; sleep 0.5; done
        if pgrep -x wivrn-server >/dev/null; then say "still running after 10 s: SIGKILL"; pkill -KILL -x wivrn-server; sleep 1; fi
        flock -w 10 "$lock" true || { say "error: $lock still held"; return 1; }  # the old start's flatpak exited
    fi
    wivrn_bg_start
}

# WiVRn streaming server (Flatpak) for the Quest. Runs in the foreground and
# holds $XDG_RUNTIME_DIR/vrdual-wivrn.lock, so only one starts via vrdual.
vrdual_wivrn() {
    local opts=() lock=${XDG_RUNTIME_DIR:-/tmp}/vrdual-wivrn.lock
    # A second server deletes the first one's IPC socket on exit (apps then fail
    # with "Failed to connect to monado service process").
    if pgrep -x wivrn-server >/dev/null; then
        say "wivrn-server already running (pid $(pgrep -x wivrn-server | paste -sd' ')); stop it first"; return 1
    fi
    systemctl is-active -q avahi-daemon 2>/dev/null || {
        opts+=(--no-publish-service)
        say "avahi-daemon not running: headset will not find the PC by itself — add it by IP: $(ip -4 -o addr show scope global | awk '$2 !~ /docker|veth|br-/ {sub("/.*","",$4); print $4; exit}')"
    }
    # The game's GPU (the display GPU) also runs the desktop and gamescope: there WiVRn's
    # compositor + encoder got 9.4 Hz under AC Origins. Mesa's device-select
    # layer puts this GPU first; vrdual-xr follows (xrGetVulkanGraphicsDevice2KHR).
    local gpu tag env=()
    gpu=$("$B/vrdual-ctl" show 2>/dev/null | awk '$1 == "wivrn_gpu" {print $2}')
    [[ ${gpu:=auto} == auto ]] && gpu=$(headless_gpu)
    case $gpu in
    pci:*) tag=${gpu#pci:}; env=(--env=DRI_PRIME=pci-${tag//[:.]/_}); say "wivrn-server on GPU $gpu (config key wivrn_gpu)" ;;
    default) ;;
    *) say "wivrn_gpu = $gpu: not pci:... or default, ignored" ;;
    esac
    local rc=0
    flock -n -E 75 "$lock" flatpak run "${env[@]}" --command=wivrn-server io.github.wivrn.wivrn "${opts[@]}" "$@" || rc=$?
    ((rc == 75)) && say "wivrn-server already started by another vrdual (lock $lock)"
    return $rc
}

# ------------------------------------------------- feedback (docs/PLAN.md §M) --
# Nothing here sends anything: the commands print prefilled GitHub URLs, the
# user reads the form and submits it (or not). --open opens them in a browser.
VRDUAL_REPO_URL=${VRDUAL_REPO_URL:-https://github.com/adderek/vrdual}

# Play log written by vrdual-xr: start, seconds, app, gpu, profile (tab separated).
games_log() { echo "${XDG_STATE_HOME:-$HOME/.local/state}/vrdual/games.tsv"; }
vrdual_games() {
    local f; f=$(games_log)
    [[ -f $f ]] || { say "no games logged yet ($f; vrdual xr writes it)"; return 0; }
    cat "$f"
}
# Controller button maps (vrdual xr reloads them live; keys in docs/CONFIG.md).
#   map [APP]                                   effective maps: mode button code source
#   map APP|--global MODE BUTTON CODE|none|default   set one (MODE: gamepad mouse both)
#   bare, on a terminal: interactive editor (game -> mode -> button -> key)
vrdual_map() {
    if (($# >= 4)); then "$B/vrdual-ctl" map-set "$@"; return; fi
    if (($# > 0)) || [[ ! -t 0 ]]; then "$B/vrdual-ctl" map "$@"; return; fi
    map_edit
}
map_edit() {
    local app mode btn code f c games=() PS3=$'\nchoose: '
    f=$(games_log)
    [[ -f $f ]] && mapfile -t games < <(tac "$f" | cut -f3 | awk 'NF && !s[$0]++' | head -15)
    say "game (recently played first):"
    select app in "${games[@]}" "[global] (all games)" "other (type the name)" quit; do
        case $app in
            quit|"") return 0 ;;
            "other (type the name)") read -rp "exe or app name (as in vrdual games): " app; [[ -n $app ]] && break ;;
            *) break ;;
        esac
    done
    local target=("$app") show=("$app")
    [[ $app == "[global]"* ]] && target=(--global) show=()
    while :; do
        say $'\n'"mode (both = map_<button>, used where no mode-specific key is set):"
        select mode in gamepad mouse both done; do [[ -n $mode ]] && break; done
        [[ $mode == done ]] && return 0
        while :; do
            say $'\n'"${show[0]:-[global]}, $mode (code, where it comes from):"
            "$B/vrdual-ctl" map "${show[@]}" | awk -v m="$mode" '$1 == m || m == "both"' | column -t -s $'\t' >&2
            say "button:"
            select btn in a b x y l3 r3 lt rt lg rg menu back; do [[ -n $btn ]] && break; done
            [[ $btn == back ]] && break
            local keys=(KEY_E KEY_F KEY_Q KEY_R KEY_I KEY_J KEY_M KEY_TAB KEY_SPACE KEY_ENTER KEY_ESC KEY_BACKSPACE
                        KEY_LEFTSHIFT KEY_LEFTCTRL KEY_LEFTALT KEY_1 KEY_2 KEY_3 KEY_4 KEY_F1 KEY_F5 KEY_F9
                        BTN_LEFT BTN_RIGHT BTN_MIDDLE)
            [[ $mode == mouse ]] || keys+=(BTN_A BTN_B BTN_X BTN_Y BTN_TL BTN_TR BTN_THUMBL BTN_THUMBR BTN_START BTN_SELECT BTN_MODE)
            say "$btn sends (default = remove this setting, the less specific one applies):"
            select code in "${keys[@]}" none default "other (type KEY_*/BTN_*)" back; do [[ -n $code ]] && break; done
            [[ $code == back ]] && continue
            [[ $code == other* ]] && read -rp "code: " code
            "$B/vrdual-ctl" map-set "${target[@]}" "$mode" "$btn" "$code" || say "not saved"
        done
    done
}
urlenc() { python3 -I -c 'import sys, urllib.parse as u; print(u.quote(sys.argv[1], safe=""))' "$1"; }
open_urls() { local u; for u; do xdg-open "$u" >/dev/null 2>&1 || say "open: $u"; done; }

# Facts about this machine for a request or report (one "Key: value" per line).
system_facts() {
    local mesa os
    mesa=$(pacman -Q mesa 2>/dev/null | cut -d' ' -f2 || true)
    [[ -n $mesa ]] || mesa=$(dpkg-query -W -f='${Version}' mesa-vulkan-drivers 2>/dev/null || rpm -q --qf '%{VERSION}' mesa-vulkan-drivers 2>/dev/null || true)
    mesa=${mesa#*:}  # package epoch
    os=$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-}")
    local gpu=${1:-$(lspci 2>/dev/null | grep -E 'VGA|3D|Display' | cut -d: -f3- | sed 's/^ //' | sort | uniq -c | sed -E 's/^ *([0-9]+) /\1x /' | paste -sd';' || true)}
    # the layer games load: vrdual install's copy, else build/ (each binary carries its own build info)
    local f ver=""
    for f in "$STEAM_FLATPAK"/vrdual/layer/libVkLayer_vrdual64.so "$HOME"/.local/share/vrdual/layer/libVkLayer_vrdual64.so "$B/libVkLayer_vrdual.so"; do
        [[ -f $f ]] && { ver="$(layer_info "$f") (layer ${f/#$HOME/\~})"; break; }
    done
    printf 'GPU: %s\nMesa: %s\nOS: %s\nvrdual: %s\n' "${gpu:-?}" "${mesa:-?}" "${os:-?}" "${ver:-?}"
}

# feedback_args [GAME] [--open]: sets game (default: last one in the play log),
# open, and gpu/secs/prof from the log lines of that game.
feedback_args() {
    local a f; game="" open=0
    for a; do case $a in --open) open=1 ;; *) game=$a ;; esac; done
    f=$(games_log)
    [[ -n $game || ! -f $f ]] || game=$(tail -n1 "$f" | cut -f3)
    [[ -n $game ]] || { say "name the game (no play log yet: $f)"; return 2; }
    gpu="" secs=0 prof=""
    [[ -f $f ]] && IFS=$'\t' read -r gpu secs prof < <(awk -F'\t' -v g="$game" '$3 == g {gpu = $4; s += $2; p = $5} END {print gpu "\t" s+0 "\t" p}' "$f")
    return 0
}

# vrdual_request [GAME] [--open]: ask for a game in Discussions. stdout:
# "search<TAB>URL" (upvote an existing request) and "new<TAB>URL" (prefilled).
vrdual_request() {
    local game open gpu secs prof body
    feedback_args "$@" || return
    body="**Game:** $game
**Store / build:** (Steam / GOG / Epic / other)
**What would you like:** (it runs but needs a profile / it does not run / ...)

---
$([[ -n $prof ]] && printf 'App name seen by vrdual: `%s`' "$game")$( ((secs > 0)) && printf ', played %s min, profile: %s' $((secs / 60)) "${prof:-none}")
$(system_facts "$gpu")"
    local s="$VRDUAL_REPO_URL/discussions/categories/game-requests?discussions_q=$(urlenc "$game")"
    local n="$VRDUAL_REPO_URL/discussions/new?category=game-requests&title=$(urlenc "$game")&body=$(urlenc "$body")"
    say "upvote an existing request if there is one; else open the new one (prefilled, edit before posting):"
    printf 'search\t%s\nnew\t%s\n' "$s" "$n"
    ((open)) && open_urls "$s" "$n"
    return 0
}

# vrdual_report [GAME] [--open]: prefilled game-report issue form
# (.github/ISSUE_TEMPLATE/game-report.yml field ids). Shows the filled fields
# on stderr, the URL on stdout.
vrdual_report() {
    local game open gpu secs prof
    feedback_args "$@" || return
    local facts; facts=$(system_facts "$gpu")
    local -a kv=(
        "game=$game" "exe=$([[ -n $prof ]] && echo "$game")"
        "gpu=$(sed -n 's/^GPU: //p' <<<"$facts"), Mesa $(sed -n 's/^Mesa: //p' <<<"$facts"), $(sed -n 's/^OS: //p' <<<"$facts")"
        "version=$(sed -n 's/^vrdual: //p' <<<"$facts")"
        "notes=$( ((secs > 0)) && printf 'Played %s min with vrdual-xr, profile: %s.' $((secs / 60)) "${prof:-none}")"
    )
    local u="$VRDUAL_REPO_URL/issues/new?template=game-report.yml&title=$(urlenc "[game] $game")" x
    say "prefilled (you fill in store, result and the rest; nothing is sent until you submit):"
    for x in "${kv[@]}"; do
        [[ -n ${x#*=} ]] || continue
        say "  ${x%%=*}: ${x#*=}"
        u+="&${x%%=*}=$(urlenc "${x#*=}")"
    done
    echo "$u"
    ((open)) && open_urls "$u"
    return 0
}

# Stereo video of a running game: SBS mp4 (_LR: VR players detect the layout),
# default into screenshots/ as <app>_<time>_LR.mp4. Game audio from the default
# output's monitor (the headset sink while xr streams); stdout = the file.
vrdual_record() {
    local out="$VRDUAL_ROOT/screenshots" audio=1 args=()
    while (($#)); do
        case $1 in
            --no-audio) audio=0 ;;
            --seconds|--fps|--session) args+=("$1" "$2"); shift ;;
            --half|--swap) args+=("$1") ;;
            -*) say "record: unknown option $1"; return 2 ;;
            *) out=$1 ;;
        esac
        shift
    done
    command -v ffmpeg >/dev/null || { say "record: ffmpeg not installed"; return 1; }
    ((audio)) && command -v pactl >/dev/null && args+=(--audio @DEFAULT_MONITOR@)
    pick_shm "${args[@]}"
    "$B/vrdual-compositor" --record "$out" --timeout 10 "${args[@]}"
}

vrdual_snapshot() {
    local out="${1:-$VRDUAL_ROOT/sbs.png}"
    vrdual_run --snapshot "$out" --at "${2:-150}" -- "$B/vrdual-cube" --frames 100000
}

# Stereo screenshot of the running game: SBS png, default
# screenshots/<app>_<time>.png; stdout = the file (and the GIF with --gif).
# --hud hide: the HUD (what hud_depth moves) not drawn; --hud still: the HUD at
# the depth of the picture's centre, so it stands still in a wiggle GIF (the
# centre's disparity measured with the HUD hidden and hud_depth 0, then
# hud_depth set to match; in games that scale their view onto the screen
# with a quad, as Civ V, the quad adds the HUD shift to the view too, the
# same hud_depth matches there). hud and hud_depth are restored afterwards.
vrdual_shot() {
    local out="" hud=show gif=0 args=() live app hd0 hm0 f dx d ew rc=0
    while (($#)); do
        case $1 in
            --hud) hud=$2; shift ;;
            --gif) gif=1 ;;
            --session) args+=("$1" "$2"); shift ;;
            -*) say "shot: unknown option $1"; return 2 ;;
            *) out=$1 ;;
        esac
        shift
    done
    case $hud in show|hide|still) ;; *) say "shot: --hud show|hide|still"; return 2 ;; esac
    pick_shm "${args[@]}"
    live=$("$B/vrdual-ctl" live "${args[@]}") || return 1
    app=$(awk '$1 == "app" {print $2}' <<<"$live"); app=${app%.exe}
    [[ -n $out ]] || out="$VRDUAL_ROOT/screenshots/${app:-game}_$(date +%Y-%m-%d_%H%M%S).png"
    hd0=$(awk '$1 == "hud_depth" {print $2}' <<<"$live"); hm0=$(awk '$1 == "hud" {print $2}' <<<"$live")
    _shot_set() { local kv; for kv in "$@"; do "$B/vrdual-ctl" "${args[@]}" set ${kv/=/ } >/dev/null || return 1; done; }
    _shot_snap() {  # a paired frame 15 frames after now (the live change applied)
        f=$("$B/vrdual-compositor" "${args[@]}" --snapshot "$1" --at 0 --timeout 30 2>&1 | grep -oE 'frame [0-9]+' | head -1 | cut -d' ' -f2)
        [[ -n $f ]] && "$B/vrdual-compositor" "${args[@]}" --snapshot "$1" --at $((f + 15)) --timeout 30 >/dev/null 2>&1
    }
    trap '_shot_set hud_depth='"$hd0"' hud='"$hm0"'; trap - INT TERM; return 130' INT TERM
    if [[ $hud == still ]]; then
        local tmpf="${TMPDIR:-/tmp}/vrdual-shot-$$.png"
        _shot_set hud=hide hud_depth=0 && _shot_snap "$tmpf" && dx=$(python3 -I "$VRDUAL_ROOT/tools/wiggle.py" "$tmpf" -) &&
            ew=$(python3 -I -c 'import sys; from PIL import Image; print(Image.open(sys.argv[1]).width // 2)' "$tmpf") || rc=1
        rm -f "$tmpf"
        if ((rc == 0)); then
            # HUD disparity (right - left) = -P00 * ipd / hud_depth * ew / 2 px = dx
            d=$(awk -v l="$live" -v dx="$dx" -v ew="$ew" 'BEGIN { n = split(l, a, "\n"); for (i = 1; i <= n; i++) { split(a[i], p, " "); v[p[1]] = p[2] }
                p00 = 1 / sin(v["hfov"] * 3.14159265 / 360) * cos(v["hfov"] * 3.14159265 / 360)
                if (dx >= 0) print 0; else printf "%.4f\n", p00 * v["ipd"] * ew / (2 * -dx) }')
            [[ $d == 0 ]] && say "shot: centre at or past infinity (disparity $dx px): HUD at infinity" ||
                say "shot: centre disparity $dx px (eye width $ew): hud_depth $d m"
            _shot_set hud=show hud_depth="$d" || rc=1
        fi
    elif [[ $hud == hide ]]; then
        _shot_set hud=hide || rc=1
    else
        _shot_set hud=show || rc=1
    fi
    ((rc == 0)) && { mkdir -p "${out%/*}"; _shot_snap "$out" || rc=1; }
    _shot_set hud_depth="$hd0" hud="$hm0"
    trap - INT TERM
    ((rc == 0)) || { say "shot: no frame (is a game running in session ${VRDUAL_SESSION:-default}?)"; return 1; }
    say "wrote $out (hud $hud)"
    echo "$out"
    ((gif)) && vrdual_wiggle "$out"
    return 0
}

# SBS screenshots -> wiggle GIFs (left/right eye alternating) next to them,
# for the README. Args: PNG files or dirs (default screenshots/). A PNG that
# already has a .gif is skipped. stdout: the GIFs written.
vrdual_wiggle() {
    local f g dx; local -a pngs=()
    (($#)) || set -- "$VRDUAL_ROOT/screenshots"
    shopt -s nullglob
    for f in "$@"; do if [[ -d $f ]]; then pngs+=("$f"/*.png); else pngs+=("$f"); fi; done
    shopt -u nullglob
    for f in "${pngs[@]}"; do
        g=${f%.png}.gif
        [[ -e $g ]] && { say "skip  $g (exists)"; continue; }
        dx=$(python3 -I "$VRDUAL_ROOT/tools/wiggle.py" "$f" "$g") || { say "FAIL  $f"; continue; }
        say "wrote $g (eyes aligned at dx=$dx px)"
        echo "$g"
    done
}

# GPU-free part of selftest (also `vrdual ci`): patcher, parsers, file
# formats, CLI. Runs in the caller's scope (tmp, B, check, label, fails).
_selftest_nogpu() {
    # 0. Game table: site/games.json valid, docs/GAMES.md generated from it.
    label="site: games.json valid, GAMES.md table up to date, translations complete"
    check python3 -I "$VRDUAL_ROOT/tools/gen_games.py" --check

    # 1. SPIR-V patcher: baked + live variants must validate; non-vertex must be refused.
    glslc "$VRDUAL_ROOT/testapp/cube.vert" -o "$tmp/glsl.spv"
    glslc -fshader-stage=vertex -x hlsl "$VRDUAL_ROOT/tools/test-shaders/hlsl_vs.hlsl" -o "$tmp/hlsl.spv"
    glslc "$VRDUAL_ROOT/testapp/cube.frag" -o "$tmp/frag.spv"
    local sh m
    for sh in glsl hlsl; do
        for m in "baked 0.03 0.02 5 0.25" "live 0x123456789a0" "baked 0.03 hud" "live 0x123456789a0 hud" "live 0x123456789a0 hide"; do
            label="spirv $sh ${m%% *}${m##*[0-9]}"
            # shellcheck disable=SC2086
            check bash -c "'$B/spvpatch' '$tmp/$sh.spv' '$tmp/p.spv' $m && spirv-val --target-env vulkan1.1 '$tmp/p.spv'"
        done
    done
    label="spirv fragment baked: nothing to do (refused)"; check bash -c "! '$B/spvpatch' '$tmp/frag.spv' '$tmp/p.spv' baked 0.1"
    # fragment shaders (hunt_fragment, hide rules): discard before OpReturn;
    # SPIR-V 1.6 has no OpKill, OpTerminateInvocation instead
    glslc --target-env=vulkan1.3 "$VRDUAL_ROOT/testapp/cube.frag" -o "$tmp/frag16.spv"
    for m in "live 0x123456789a0" "baked 0 hide"; do
        label="spirv frag ${m%% *}${m##*[0-9]}"
        # shellcheck disable=SC2086
        check bash -c "'$B/spvpatch' '$tmp/frag.spv' '$tmp/p.spv' $m && spirv-val --target-env vulkan1.1 '$tmp/p.spv' && spirv-dis '$tmp/p.spv' | grep -q OpKill"
    done
    label="spirv frag live: SPIR-V 1.0 and 1.6 (OpTerminateInvocation) validate"
    check bash -c "'$B/spvpatch' '$tmp/frag.spv' '$tmp/p.spv' live 0x123456789a0 && spirv-val --target-env spv1.0 '$tmp/p.spv' &&
        '$B/spvpatch' '$tmp/frag16.spv' '$tmp/p.spv' live 0x123456789a0 && spirv-val --target-env vulkan1.3 '$tmp/p.spv' && spirv-dis '$tmp/p.spv' | grep -q OpTerminateInvocation"
    # tessellation evaluation / geometry: the last pre-raster stage when present
    for sh in tese geom; do
        glslc "$VRDUAL_ROOT/testapp/cube.$sh" -o "$tmp/$sh.spv"
        for m in "baked 0.03" "live 0x123456789a0" "live 0x123456789a0 hide"; do
            label="spirv $sh ${m%% *}${m##*[0-9]}"
            # shellcheck disable=SC2086
            check bash -c "'$B/spvpatch' '$tmp/$sh.spv' '$tmp/p.spv' $m && spirv-val --target-env vulkan1.1 '$tmp/p.spv'"
        done
    done
    label="spirv geometry: patched before every EmitVertex, gate spec constant 'vrd1'"
    check bash -c "'$B/spvpatch' '$tmp/geom.spv' '$tmp/p.spv' live 0x123456789a0 && d=\$(spirv-dis '$tmp/p.spv') &&
        grep -q 'SpecId 1987208241' <<<\"\$d\" && grep -q 'OpSpecConstantTrue' <<<\"\$d\""
    # uvec2 -> PhysicalStorageBuffer pointer bitcast: core only since SPIR-V 1.5,
    # legal earlier through SPV_KHR_physical_storage_buffer (which the patch adds)
    label="spirv live output validates as SPIR-V 1.0 (glslc's default)"
    check bash -c "'$B/spvpatch' '$tmp/glsl.spv' '$tmp/p.spv' live 0x123456789a0 && spirv-val --target-env spv1.0 '$tmp/p.spv'"
    label="spirv fuzz: 4x50000 mutated modules through every patch mode under ASan"
    check "$B/spvpatch-asan" --fuzz 50000 "$tmp/glsl.spv" "$tmp/hlsl.spv" "$tmp/geom.spv" "$tmp/frag.spv"
    label="frame reader: producer re-init to a bigger size is refused until remap; no per-frame allocation; pairs straight into caller buffers"
    mkdir -p "$tmp/frames"; check "$B/vrdual-frames-test" "$tmp/frames"
    label="guided IPD calibration: simulated viewers 50-80 mm converge within 0.5 mm, near IPD found or left off"
    check "$B/vrdual-calib-test"
    label="game fixes: culling planes plain and widened, byte-checked patch (applied / already / unknown build / unmapped)$([[ -x $B/lib32/vrdual-gamefix-test ]] && echo ', 32-bit jmp into the Civ V hook')"
    check bash -c "'$B/vrdual-gamefix-test' >/dev/null && { [[ ! -x '$B/lib32/vrdual-gamefix-test' ]] || '$B/lib32/vrdual-gamefix-test' >/dev/null; }"
    label="game profiles: all valid (exe, known keys); a bad one is refused"
    check bash -c "'$B/vrdual-ctl' profiles '$VRDUAL_ROOT/profiles' >/dev/null && mkdir -p '$tmp/badprof' &&
        printf '[game]\\nexe = x.exe\\n[settings]\\nworld_scal = 2\\n' >'$tmp/badprof/x.conf' &&
        ! '$B/vrdual-ctl' profiles '$tmp/badprof' >/dev/null 2>&1"
    label="game profile: Psychonauts gets skip_w1 = 0 by exe, Mirror's Edge by Steam app id; [app:NAME] wins over a profile, a profile over [global]"
    check bash -c "export VRDUAL_PROFILES='$VRDUAL_ROOT/profiles'; VRDUAL_CONFIG=/nonexistent '$B/vrdual-ctl' show Psychonauts | grep -q '^skip_w1 *0 *# profile psychonauts' &&
        SteamAppId=17410 VRDUAL_CONFIG=/nonexistent '$B/vrdual-ctl' show Game.exe | grep -q '^world_scale *50 *# profile mirror-s-edge' &&
        printf '[global]\\nworld_scale = 3\\nhud_depth = 7\\n[app:mirrorsedge.exe]\\nworld_scale = 40\\n' >'$tmp/prof.conf' &&
        o=\$(VRDUAL_CONFIG='$tmp/prof.conf' '$B/vrdual-ctl' show mirrorsedge.exe) && grep -q '^world_scale *40 ' <<<\"\$o\" && grep -q '^hud_depth *1 *# profile' <<<\"\$o\""
    label="intro off / on: the profile's intro globs renamed to .orig and back (by exe, appid, file name), other files untouched, twice = no change"
    check bash -c "d='$tmp/introgame'; mkdir -p \$d/Video && : >\$d/Video/Title_Game.bik && : >\$d/Video/Title_Dev.bik && : >\$d/Video/Attract.bik
        i() { '$VRDUAL_ROOT/vrdual' intro \$1 \$2 --dir \$d 2>/dev/null; }
        [[ \$(i off overlord.i386 | cut -f1 | sort -u) == off ]] && [[ \$(i off 11450 | wc -l) == 2 ]] && [[ -f \$d/Video/Title_Game.bik.orig && ! -e \$d/Video/Title_Game.bik && -f \$d/Video/Attract.bik ]] &&
        [[ \$(i on overlord | cut -f1 | sort -u) == on ]] && [[ -f \$d/Video/Title_Dev.bik && ! -e \$d/Video/Title_Dev.bik.orig ]] &&
        [[ \$(i status overlord) == \$'on\t'\$d/Video/Title_Dev.bik\$'\n'\$'on\t'\$d/Video/Title_Game.bik ]] && ! i off psychonauts && ! i off nosuchgame || { ls -R \$d; false; }"
    label="build info: vrdual version lists tools and layers; SOURCE_DATE_EPOCH fixes the time"
    check bash -c "v=\$('$VRDUAL_ROOT/vrdual' version) && grep -q \$'^tools\tvrdual .*, built .* on ' <<<\"\$v\" &&
        grep -q 'build/libVkLayer_vrdual.so.*, built ' <<<\"\$v\" &&
        SOURCE_DATE_EPOCH=0 '$VRDUAL_ROOT/tools/build_info.sh' | grep -q ', built 1970-01-01 00:00:00 +0000 on ' || { echo \"\$v\"; false; }"
    label="feedback: request / report URLs prefilled from the play log, nothing sent"
    check bash -c "export XDG_STATE_HOME='$tmp/fb'; mkdir -p \$XDG_STATE_HOME/vrdual
        printf '2026-10-21 10:00:00\t600\tmirrorsedge.exe\tAMD Radeon RX 7900 XTX (RADV NAVI31)\tbuilt-in\n' >\$XDG_STATE_HOME/vrdual/games.tsv
        r=\$('$VRDUAL_ROOT/vrdual' request 2>/dev/null) && p=\$('$VRDUAL_ROOT/vrdual' report 2>/dev/null) &&
        grep -q \$'^search\thttps://github.com/.*/discussions/categories/game-requests?discussions_q=mirrorsedge.exe\$' <<<\"\$r\" &&
        grep -q \$'^new\thttps://github.com/.*/discussions/new?category=game-requests&title=mirrorsedge.exe&body=.*played%2010%20min' <<<\"\$r\" &&
        grep -q '/issues/new?template=game-report.yml&title=%5Bgame%5D%20mirrorsedge.exe&game=mirrorsedge.exe&exe=mirrorsedge.exe&gpu=AMD%20Radeon' <<<\"\$p\" &&
        grep -q '&version=vrdual%20.*%2C%20built%20.*%28layer%20' <<<\"\$p\" &&
        grep -q '&notes=Played%2010%20min.*built-in' <<<\"\$p\" || { echo \"\$r\"; echo \"\$p\"; false; }"
    # Saves replace the file in one step: a game starting meanwhile never reads
    # a truncated config (the old in-place rewrite did, ~1 % of reads here).
    label="config save: readers never see a partial file; a symlinked config stays a symlink, its mode kept"
    check bash -c "d='$tmp/cfgsave'; mkdir -p \$d/real; c=\$d/real/vrdual.conf
        { echo '[global]'; echo 'ipd = 0.07'; for i in \$(seq 2000); do echo \"# filler line \$i\"; done; } >\$c; chmod 600 \$c; ln -s \$c \$d/link.conf
        export VRDUAL_CONFIG=\$d/link.conf
        ( for i in \$(seq 100); do '$B/vrdual-ctl' map-set --global gamepad y none 2>/dev/null && '$B/vrdual-ctl' map-set --global gamepad y default 2>/dev/null || exit 1; done ) & w=\$!
        bad=0; while kill -0 \$w 2>/dev/null; do grep -q '^ipd = 0.07' \$d/link.conf || bad=\$((bad+1)); done
        wait \$w && ((bad == 0)) && [[ -L \$d/link.conf && \$(stat -c %a \$c) == 600 && \$(ls \$d/real) == vrdual.conf ]] || { echo \"partial reads: \$bad\"; ls -la \$d \$d/real; false; }"
    label="docs/CONFIG.md lists every config key"
    check bash -c "VRDUAL_CONFIG=/nonexistent '$B/vrdual-ctl' show | awk '{print \$1}' | while read -r k; do grep -q \"\\\`\$k\\\`\" '$VRDUAL_ROOT/docs/CONFIG.md' || { echo \"missing: \$k\"; exit 1; }; done"

    # Input mapping (controllers -> pad / mouse / keys) and a uinput pad round trip.
    label="input: mapper scenarios$( "$B/vrdual-input-test" ${CI:+--no-uinput} 2>/dev/null | grep -q '^skip  uinput' && echo ' (uinput skipped)' || echo ', uinput pad read back')"
    check "$B/vrdual-input-test" ${CI:+--no-uinput}  # GitHub sets CI: its /dev/uinput is root-only
}

# GPU-free checks only, no windows (seconds): the local pre-push gate and
# GitHub's CI (.github/workflows/ci.yml). exit 0 = pass.
vrdual_ci() {
    local tmp fails=0
    tmp=$(mktemp -d)
    _VRDUAL_SELFTEST_TMP=$tmp
    trap 'rm -rf "${_VRDUAL_SELFTEST_TMP:-/nonexistent}"; trap - RETURN' RETURN
    check() { if "$@" >"$tmp/out" 2>&1; then say "PASS  $label"; else say "FAIL  $label"; sed 's/^/      /' "$tmp/out" >&2; fails=$((fails+1)); fi; }
    make -C "$VRDUAL_ROOT" -j"$(nproc)" ci >&2 || return 1
    _selftest_nogpu
    if ((fails)); then say "ci: $fails FAILED"; return 1; fi
    say "ci: all passed"
}

# Automated verification; exit 0 = everything passed. Opens two small windows
# for ~20 s (one per GPU). Uses an empty temporary config, session "selftest".
vrdual_selftest() {
    local tmp fails=0 sess=selftest
    tmp=$(mktemp -d)
    _VRDUAL_SELFTEST_TMP=$tmp
    # vrdual-xr runs here with simulated controllers and head turns: only the
    # virtual pad may be created, never a keyboard or mouse that would type
    # into the desktop (head_look = scroll once left arrows stuck there).
    export VRDUAL_UINPUT_PAD_ONLY=1
    trap 'kill $(jobs -p) 2>/dev/null || true; rm -rf "${_VRDUAL_SELFTEST_TMP:-/nonexistent}"; rm -f /dev/shm/vrdual-selftest-*; trap - RETURN' RETURN
    check() { if "$@" >"$tmp/out" 2>&1; then say "PASS  $label"; else say "FAIL  $label"; sed 's/^/      /' "$tmp/out" >&2; fails=$((fails+1)); fi; }
    vrdual_build || return 1
    # The user's real installs (what games load) must come out untouched: a
    # check running `vrdual xr` without --no-install once copied the empty
    # test config over them.
    inst_sum() { find "$STEAM_FLATPAK/vrdual" "$HOME/.local/share/vrdual" -type f ! -name game.log -exec md5sum {} + 2>/dev/null | sort; }
    local inst0; inst0=$(inst_sum)

    _selftest_nogpu

    # 1b. vrdual install into a fresh HOME: wrapper + both layers + launch
    # option; `vrdual xr`'s --quiet run is silent when nothing changed and
    # replaces a layer copy that differs from build/.
    label="install: fresh HOME gets wrapper, both layers, profiles, launch option; --quiet silent when current, updates a stale layer"
    check env HOME="$tmp/home" XDG_CONFIG_HOME="$tmp/home/.config" bash -c "cd '$VRDUAL_ROOT' && d=\$HOME/.local/share/vrdual &&
        ./vrdual install 2>/dev/null | grep -q '/.local/share/vrdual/run %command%\$' && [[ -x \$d/run && -f \$d/layer/libVkLayer_vrdual32.so && -f \$d/layer/VkLayer_vrdual64.json ]] &&
        out=\$(bash -c 'source ./_; vrdual_install --quiet' 2>&1) && [[ -z \$out ]] && printf x >>\$d/layer/libVkLayer_vrdual64.so &&
        bash -c 'source ./_; vrdual_install --quiet' 2>&1 | grep -q 'updated the layer' && cmp -s build/libVkLayer_vrdual.so \$d/layer/libVkLayer_vrdual64.so &&
        diff -rq profiles \$d/profiles && grep -q 'VRDUAL_PROFILES=.*\$d/profiles' \$d/run"
    # 1c. vrdual perf on a fake Flatpak Steam tree: Proton log, manifest,
    # prefix, install dir with a wrapper DLL and a mods dir, xr log.
    label="perf: Proton/DXVK, mode, GPUs, config, game fps of the last xr session, prefix + install configs, mod hints"
    local ph="$tmp/perfhome"; local pst="$ph/.var/app/com.valvesoftware.Steam"
    mkdir -p "$pst/.local/share/Steam/steamapps/common/tg/mods" "$pst/.local/share/Steam/steamapps/compatdata/4242/pfx/drive_c/users/steamuser/Documents/My Games/TG" "$ph/state/vrdual"
    printf '"libraryfolders"\n{\n\t"0"\n\t{\n\t\t"path"\t\t"%s"\n\t}\n}\n' "$pst/.local/share/Steam" >"$pst/.local/share/Steam/steamapps/libraryfolders.vdf"
    printf '"AppState"\n{\n\t"appid"\t\t"4242"\n\t"name"\t\t"Test Game"\n\t"installdir"\t\t"tg"\n}\n' >"$pst/.local/share/Steam/steamapps/appmanifest_4242.acf"
    : >"$pst/.local/share/Steam/steamapps/common/tg/dxgi.dll"; echo x >"$pst/.local/share/Steam/steamapps/common/tg/tg.ini"
    echo '[Video]' >"$pst/.local/share/Steam/steamapps/compatdata/4242/pfx/drive_c/users/steamuser/Documents/My Games/TG/settings.ini"
    cat >"$pst/steam-4242.log" <<'EOF'
