        label="openxr: warns at game start when the installed config copy is stale"
        mkdir -p "$tmp/fshm" && echo 'world_scale = 2' >"$tmp/copy.conf"
        check bash -c "VRDUAL_SHM_DIR='$tmp/fshm' $cube >'$tmp/g3.log' 2>&1 & g=\$!
            XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 VRDUAL_SHM_DIR='$tmp/fshm' VRDUAL_CONF_COPY='$tmp/copy.conf' timeout 30 '$B/vrdual-xr' --session $sess --frames 30 >'$tmp/xr8.log' 2>&1
            kill \$g; wait \$g
