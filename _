        [[ \$(DISPLAY=:0 VRDUAL_DISPLAY=:7 '$tmp/umu-shim' sh -c 'echo \$DISPLAY') == :7 ]] && [[ \$(DISPLAY=:0 '$tmp/umu-shim' sh -c 'echo \$DISPLAY') == :0 ]]"
    label="the user's installed layer, wrapper, config copy and profiles untouched"
    check diff <(printf '%s\n' "$inst0") <(inst_sum)
    unset VRDUAL_CONFIG XDG_STATE_HOME
    if ((fails)); then say "selftest: $fails FAILED"; return 1; fi
    say "selftest: all passed"
