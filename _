        label="openxr: frame loop stuck in a runtime call -> watchdog reconnects in a new process"
        check bash -c "XR_RUNTIME_JSON='$xrj' SIMULATED_ENABLE=1 XRT_COMPOSITOR_NULL=1 VRDUAL_XR_HANG_AT=20 VRDUAL_XR_HANG_S=2 timeout 40 '$B/vrdual-xr' --session $sess --frames 30 >'$tmp/xr7.log' 2>&1;
