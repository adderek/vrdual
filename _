    fi
    label="wiggle: SBS png -> 2-frame gif, existing gif skipped"
    # own dir: $tmp holds the other checks' snapshots
    check bash -c "mkdir -p '$tmp/wig' && cp '$VRDUAL_ROOT/docs/sbs-example.png' '$tmp/wig/w.png' && cd '$VRDUAL_ROOT' && source ./_ &&
        [[ \$(vrdual_wiggle '$tmp/wig') == '$tmp/wig/w.gif' ]] && [[ \$(identify '$tmp/wig/w.gif' | wc -l) == 2 ]] && [[ -z \$(vrdual_wiggle '$tmp/wig') ]]"
    label="umu-shim patch: once, restores gamescope's DISPLAY from VRDUAL_DISPLAY"
    check bash -c "printf '#!/bin/sh\nexec \"\$@\"\n' >'$tmp/umu-shim' && chmod +x '$tmp/umu-shim' && cd '$VRDUAL_ROOT' && source ./_ &&
