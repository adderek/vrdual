EOF
    printf '%s\n' "2026-11-02 10:00:00.000 [xr] app 'tg.exe': input=off" \
        "2026-11-02 10:00:05.000 [xr] 300 frames submitted, 150 new game frames (30.0/s), headset 60.0 Hz" \
        "2026-11-02 10:00:10.000 [xr] 600 frames submitted, 300 new game frames (60.0/s), headset 60.0 Hz" \
        "2026-11-02 10:00:15.000 [xr] app 'other.exe': input=off" \
        "2026-11-02 10:00:20.000 [xr] 900 frames submitted, 900 new game frames (99.0/s), headset 60.0 Hz" >"$ph/state/vrdual/xr.log"
    printf '[app:tg.exe]\nworld_scale = 7\n' >"$tmp/perf.conf"
    check env HOME="$ph" XDG_STATE_HOME="$ph/state" VRDUAL_CONFIG="$tmp/perf.conf" bash -c "o=\$('$VRDUAL_ROOT/vrdual' perf 4242 2>/dev/null) &&
        for w in \$'game\tTest Game' \$'exe\ttg.exe' \$'proton\t123 proton-9.0-4' \$'dxvk\tv2.7.1' \$'mode\tmirror' \$'gpu\tdevice created on GPU A (pci 0000:01:00.0)' \
            \$'gpu\tmirror: twin device on GPU B (pci 0000:02:00.0)' \$'resolution\t1920x1080' \$'profile\ttg.exe' \$'xr_session\t2026-11-02 10:00:00 .. 2026-11-02 10:00:10' \
            \$'xr_game_fps\t45.0 avg, 60.0 max over 2 stats lines (5 s each)' \$'mod_hint\t$pst/.local/share/Steam/steamapps/common/tg/dxgi.dll' \$'mod_hint\t$pst/.local/share/Steam/steamapps/common/tg/mods'; do
            grep -qxF \"\$w\" <<<\"\$o\" || { echo \"missing: \$w\"; echo \"\$o\"; exit 1; }; done &&
        grep -qP '^config\tworld_scale\t7\t.*\[app:tg.exe\]\$' <<<\"\$o\" && grep -qP '^export\texport: 0.50 ms/frame' <<<\"\$o\" &&
        grep -qP '^game_config\tprefix\t.*/My Games/TG/settings.ini\t' <<<\"\$o\" && grep -qP '^game_config\tinstall\t.*/tg/tg.ini\t' <<<\"\$o\" &&
        [[ \$('$VRDUAL_ROOT/vrdual' perf tg.exe 2>/dev/null) == \"\$o\" ]] || { echo \"\$o\"; false; }"


    # 2. End to end on both GPUs: static calibration scene, live changes via the control block.
    export VRDUAL_CONFIG="$tmp/empty.conf"; : >"$VRDUAL_CONFIG"
    export XDG_STATE_HOME="$tmp/state"  # vrdual-xr's play log
    # Checks 2, 3, 3b and 4a need two GPUs: gd = the first with a connected
    # monitor (display GPU, the app's), gh = the first without (headless).
    # Found from sysfs, never by fixed address: slots and cables move.
    local gd="" gh="" two=0 d
    for d in /sys/bus/pci/devices/*; do
        [[ $(cat "$d/class" 2>/dev/null) == 0x03* ]] || continue
        if grep -qx connected "$d"/drm/card*/card*-*/status 2>/dev/null; then gd=${gd:-${d##*/}}; else gh=${gh:-${d##*/}}; fi
    done
    [[ -n $gd && -n $gh ]] && two=1
    snap() {  # newest paired frame at least 15 frames after now; more args go to the compositor (--depth F)
        local f
        f=$("$B/vrdual-compositor" --session $sess --snapshot "$1" "${@:2}" --at 0 --timeout 20 2>&1 | grep -oE 'frame [0-9]+' | head -1 | cut -d' ' -f2)
        [[ -n $f ]] && "$B/vrdual-compositor" --session $sess --snapshot "$1" "${@:2}" --at $((f + 15)) --timeout 20 >/dev/null 2>&1
    }
    set_live() { local kv; for kv in "$@"; do "$B/vrdual-ctl" --session $sess set ${kv/=/ } >/dev/null || return 1; done; }
    local M="python3 -I $VRDUAL_ROOT/tools/measure_posts.py"
    local i
    if (( two )); then
    rm -f /dev/shm/vrdual-$sess-*
    local e
    for e in left right; do
        env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=$e VRDUAL_DEPTH_EXPORT=1 \
            "$B/vrdual-cube" --scene calib --title "selftest $e" >"$tmp/$e.log" 2>&1 &
    done
    for i in $(seq 100); do grep -q exporting "$tmp/left.log" && grep -q exporting "$tmp/right.log" && break; sleep 0.1; done
    label="two GPUs selected (gpu = auto: the one with the monitor left)"
    check bash -c "grep -q 'pci $gd' '$tmp/left.log' && grep -q 'pci $gh' '$tmp/right.log' &&
        grep -q 'gpu auto (left eye): pci:$gd' '$tmp/left.log' && grep -q 'gpu auto (right eye): pci:$gh' '$tmp/right.log'"
    label="live params enabled"; check grep -q 'live params at device address' "$tmp/left.log" "$tmp/right.log"
    label="export stats: copy wait and publish time per frame logged"
    check bash -c "for i in \$(seq 100); do grep -qE 'export: [0-9.]+ ms/frame waiting for the copy, [0-9.]+ ms/frame publishing' '$tmp/left.log' && exit 0; sleep 0.1; done; exit 1"
    label="default ipd 64mm";    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/a.png' && $M '$tmp/a.png' --ipd 0.064 --anchor center"
    label="depth_export: render pass depth image picked, left depth plane = the posts' distances where the left image has them"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; grep -q 'depth_export: image .* format 126 ' '$tmp/left.log' &&
        snap '$tmp/dep.png' --depth '$tmp/dep.pfm' && $M '$tmp/dep.png' --ipd 0.064 --anchor center --depth '$tmp/dep.pfm' || { grep depth_export '$tmp/left.log'; false; }"
    set_live ipd=0.2
    label="live ipd 200mm";      check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/b.png' && $M '$tmp/b.png' --ipd 0.2 --anchor center"
    set_live ipd=0.064 anchor=left
    label="anchor left";         check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/c.png' && $M '$tmp/c.png' --ipd 0.064 --anchor left"
    set_live anchor=right
    label="anchor right";        check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/d.png' && $M '$tmp/d.png' --ipd 0.064 --anchor right"
    set_live anchor=center ipd_near=0.2 near_dist=1 far_dist=5
    label="near/far blend";      check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/e.png' && $M '$tmp/e.png' --ipd 0.064 --ipd-near 0.2 --near 1 --far 5"
    set_live ipd_near=0 head_yaw=6
    label="head yaw 6 deg (clip rotation M = D R^T D^-1): posts where the turned camera sees them, HUD bar stays"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/yaw.png' && $M '$tmp/yaw.png' --ipd 0.064 --anchor center --head-yaw 6"
    set_live head_yaw=0 hud_yaw=6
    label="hud_yaw 6 deg: HUD bar turned like the scene (homography), posts unchanged"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/hudyaw.png' && $M '$tmp/hudyaw.png' --ipd 0.064 --anchor center --hud-yaw 6"
    set_live hud_yaw=0
    # Shader hunt: both processes list the test shader's key; hide over the
    # whole key range leaves only the background, off brings the posts back.
    label="shader list: test shader key, once"
    check bash -c "k=\$('$B/spvpatch' --hash '$tmp/glsl.spv') && [[ \$('$B/vrdual-ctl' --session $sess shaders) == \$k ]]"
    "$B/vrdual-ctl" --session $sess hunt hide 00000000 ffffffff >/dev/null
    label="hunt hide: all shaders hidden live"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/hh.png' && (( \$(convert '$tmp/hh.png' -unique-colors -format %w info:) <= 2 ))"
    "$B/vrdual-ctl" --session $sess hunt off >/dev/null
    # hunt find, the oracle is the picture: with the cube's shader hidden only
    # the background is left. 5 fake keys make it a real bisection.
    label="hunt find (vrdual-ctl, answers on stdin): picture as the oracle, 6 keys -> the cube's shader, rule saved, hunt off"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; f=/dev/shm/vrdual-$sess-shaders; k=\$('$B/spvpatch' --hash '$tmp/glsl.spv'); cp \$f '$tmp/shaders.bak'
        for x in 10 30 50 a0 c0; do printf '%s00000000000000\\n' \$x >>\$f; done
        export VRDUAL_CONFIG='$tmp/hunt.conf'; : >\$VRDUAL_CONFIG; found=''
        coproc H { '$B/vrdual-ctl' --session $sess hunt find hide 2>&1; }; p=\$H_PID
        while IFS= read -r l <&\${H[0]}; do
            case \$l in
                *'quit (q)') snap '$tmp/hf.png'; (( \$(convert '$tmp/hf.png' -unique-colors -format %w info:) <= 2 )) && a=y || a=n; echo \"\$l -> \$a\" >&2; echo \$a >&\${H[1]} ;;
                'rule '*) echo s >&\${H[1]} ;;
                *) [[ \$l =~ ^[0-9a-f]{16}\$ ]] && found=\$l ;;
            esac
        done 2>'$tmp/hf.log'
        wait \$p; rc=\$?; cp '$tmp/shaders.bak' \$f
        [[ \$rc == 0 && \$found == \$k ]] && grep -qx \"shader_rules = \$k:hide\" \$VRDUAL_CONFIG &&
            '$B/vrdual-ctl' --session $sess hunt | grep -q '^hunt off' || { echo rc=\$rc found=\$found k=\$k; cat '$tmp/hf.log' \$VRDUAL_CONFIG; false; }"
    label="hunt off: posts back, ipd 64mm"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/ho.png' && $M '$tmp/ho.png' --ipd 0.064 --anchor center"
    label="config init: built-in button maps listed commented, both modes"
    check bash -c "VRDUAL_CONFIG='$tmp/init.conf' '$B/vrdual-ctl' init >/dev/null && [[ \$(grep -c '^# map_\\(gamepad\\|mouse\\)_' '$tmp/init.conf') == 23 ]] &&
        grep -qx '# map_mouse_rt = BTN_LEFT' '$tmp/init.conf' && grep -qx '# map_gamepad_a = BTN_A' '$tmp/init.conf' && ! grep -q '^map_' '$tmp/init.conf'"
    label="vrdual map: editor (piped choices) and machine form write per-mode keys, default removes, map shows the source"
    check bash -c "export VRDUAL_CONFIG='$tmp/map.conf' XDG_STATE_HOME='$tmp/mapst'; mkdir -p '$tmp/mapst/vrdual'
        printf '2026-10-29 20:00:00\\t10\\tSome Game.exe\\tgpu\\tnone\\n' >'$tmp/mapst/vrdual/games.tsv'
        printf '1\\n2\\n3\\n1\\n12\\n4\\n' | bash -c 'source \"$VRDUAL_ROOT/_\"; map_edit' >/dev/null 2>&1
        '$VRDUAL_ROOT/vrdual' map --global both y none 2>/dev/null && '$VRDUAL_ROOT/vrdual' map 'Some Game.exe' gamepad a BTN_B 2>/dev/null &&
        '$VRDUAL_ROOT/vrdual' map 'Some Game.exe' gamepad a default 2>/dev/null && ! '$VRDUAL_ROOT/vrdual' map 'Some Game.exe' mouse a KEY_NOPE 2>/dev/null &&
        m=\$('$VRDUAL_ROOT/vrdual' map 'Some Game.exe') && grep -qP '^mouse\\tx\\tKEY_E\\t\\[app:some game.exe\\] map_mouse_x' <<<\"\$m\" &&
        grep -qP '^gamepad\\ty\\tnone\\t\\[global\\] map_y' <<<\"\$m\" && grep -qP '^gamepad\\ta\\tBTN_A\\tbuilt-in' <<<\"\$m\" || { cat '$tmp/map.conf'; false; }"
    label="save: profile without ipd keys, --global with them"
    check bash -c "export VRDUAL_CONFIG='$tmp/save.conf'; c='$B/vrdual-ctl --session $sess'; \$c save >/dev/null 2>&1 && \$c save --global >/dev/null 2>&1 &&
        awk 'BEGIN{s=\"[global]\"} /^\[/{s=\$0} /^(ipd|ipd_near|near_dist|far_dist) /{print s}' '$tmp/save.conf' | sort -u | grep -qx '\[global\]' &&
        ! awk 'BEGIN{s=\"[global]\"} /^\[/{s=\$0} /^(ipd|ipd_near|near_dist|far_dist) /{print s}' '$tmp/save.conf' | grep -q app: && grep -q '^\[app:' '$tmp/save.conf'"
    # Compositor keys pressed in its window (injected SDL events, software
    # renderer: no load on the display GPU); W saves, Q quits.
    set_live ipd=0.064 anchor=center hfov=90 near_dist=1
    label="compositor keys: IPD steps (Shift = fine), anchor, hfov, near dist, W saves the profile, Q quits"
    check bash -c "export VRDUAL_CONFIG='$tmp/keys.conf'; : >\$VRDUAL_CONFIG
        SDL_RENDER_DRIVER=software timeout 20 '$B/vrdual-compositor' --session $sess --scale 0.25 --keys 'Up Up Shift+Up Down A = ] W Q' &&
        '$B/vrdual-ctl' --session $sess live | awk '\$1==\"ipd\"{i=\$2} \$1==\"anchor\"{a=\$2} \$1==\"hfov\"{h=\$2} \$1==\"near_dist\"{n=\$2}
            END{exit !(i>0.06459 && i<0.06461 && a==\"left\" && h==91 && n>1.09 && n<1.11)}' &&
        grep -qx '\[app:vrdual-cube\]' \$VRDUAL_CONFIG && grep -qx 'anchor = left' \$VRDUAL_CONFIG && grep -qx 'hfov = 91' \$VRDUAL_CONFIG ||
        { '$B/vrdual-ctl' --session $sess live; cat \$VRDUAL_CONFIG; false; }"
    # Guided calibration, a viewer whose IPD is 62.3 mm: 65 near, 57.5 far,
    # 61.25 far, 63.125 near, 62.19 far, 62.66 near -> 62.42; near post right.
    label="guided calibration in the compositor: 6 answers -> ipd 62.4 mm, near off, saved to [global]; Backspace restores"
    check bash -c "export VRDUAL_CONFIG='$tmp/guided.conf'; : >\$VRDUAL_CONFIG; c='$B/vrdual-compositor --session $sess --scale 0.25'
        SDL_RENDER_DRIVER=software timeout 20 \$c --keys 'G Left Right Right Left Right Left Return Q' &&
        '$B/vrdual-ctl' --session $sess live | awk '\$1==\"ipd\"{i=\$2} \$1==\"ipd_near\"{n=\$2} END{exit !(i>0.0618 && i<0.0628 && n==0)}' &&
        grep -q '^ipd = 0.0624' \$VRDUAL_CONFIG && grep -qx 'ipd_near = 0' \$VRDUAL_CONFIG && ! grep -q '^\[app:' \$VRDUAL_CONFIG &&
        SDL_RENDER_DRIVER=software timeout 20 \$c --keys 'G Left Right Backspace Q' &&
        '$B/vrdual-ctl' --session $sess live | grep -q '^ipd 0.0624' || { '$B/vrdual-ctl' --session $sess live; cat \$VRDUAL_CONFIG; false; }"
    set_live ipd=0.064 anchor=center hfov=90
    kill $(jobs -p) 2>/dev/null; wait 2>/dev/null

    # Lockstep after a stall past lockstep_timeout_ms: the right eye renders
    # 4K (slower), is stopped for 1 s, and must not stay behind for good: the
    # left one has to wait for it again (last_frame at header offset 40).
    label="lockstep: eyes back in step after the slower one stalled longer than lockstep_timeout_ms"
    rm -f /dev/shm/vrdual-$sess-*
    local rpid
    for e in left right; do
        env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=$e \
            "$B/vrdual-cube" --scene calib $([[ $e == right ]] && echo --size 3840x2160) --title "selftest lockstep $e" >"$tmp/ls-$e.log" 2>&1 &
        rpid=$!
    done
    for i in $(seq 100); do grep -q exporting "$tmp/ls-left.log" && grep -q exporting "$tmp/ls-right.log" && break; sleep 0.1; done
    sleep 1; kill -STOP "$rpid"; sleep 1; kill -CONT "$rpid"
    check python3 -I -c "
import struct, sys, time
def lf(e):
    with open('/dev/shm/vrdual-$sess-%d' % e, 'rb') as f:
        f.seek(40)
        return struct.unpack('<Q', f.read(8))[0]
gap0 = lf(0) - lf(1)
if gap0 <= 3: sys.exit('the stall made no gap (%d): test invalid' % gap0)
end = time.time() + 30
while time.time() < end:
    l, r = lf(0), lf(1)
    if abs(l - r) <= 2: sys.exit(0)
    time.sleep(0.05)
sys.exit('gap %d after the stall, still %d frames apart' % (gap0, l - r))"
    kill $(jobs -p) 2>/dev/null; wait 2>/dev/null

    # Wine: /proc/self/exe = the preloader, argv[0] = the Windows path; matches the built-in [app:upc.exe]
    label="stereo = 0 (launchers, by Wine argv[0]): layer passive in mirror mode, app renders, no frame files"
    rm -f /dev/shm/vrdual-$sess-*
    cp "$B/vrdual-cube" "$tmp/wine64-preloader"
    check bash -c "env VK_ADD_LAYER_PATH='$B' VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        bash -c 'exec -a \"C:\\\\Ubisoft\\\\upc.exe\" \"\$0\" \"\$@\"' '$tmp/wine64-preloader' --frames 30 --size 320x240 --title 'selftest stereo off' >'$tmp/off.log' 2>&1 &&
        grep -q \"exe='wine64-preloader upc.exe': stereo = 0, layer passive\" '$tmp/off.log' && ! grep -q 'twin device' '$tmp/off.log' && ! ls /dev/shm/vrdual-$sess-0 2>/dev/null"

    # 3. Mirror mode: ONE process, the app sees one GPU, the layer replays on the other.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --clear-alpha 0 --title "selftest mirror" >"$tmp/mirror.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images' "$tmp/mirror.log" && break; sleep 0.1; done
    label="build info: layer logs version, ISO build time and this machine"
    check grep -qE "^\[vrdual:LR\] vrdual [^ ]+, built [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4} on $(uname -n) \(64-bit layer\)$" "$tmp/mirror.log"
    # Destroy/Free wrappers translate the handle before A frees it (A may hand the value to a new object on another thread)
    label="mirror: Destroy/Free wrappers translate handles before A's call"
    check awk '/^static .* m_(Destroy|Free)[A-Za-z0-9]*\(/ { f = $0; a = 0 } f && /^    (VkResult r = )?md->a\./ { a = 1 }
        f && a && /c\.xl\(|xl_handle\(/ { print "late translation in " f; bad = 1 } /^}/ { f = "" } END { exit bad }' "$B/mirror_gen.hpp" "$VRDUAL_ROOT/layer/vrdual_mirror.hpp"
    label="mirror: app sees 1 GPU, twin on the headless one"; check bash -c "grep -q 'app sees 1 GPU' '$tmp/mirror.log' && grep -q 'twin device on .*$gh' '$tmp/mirror.log'"
    label="mirror: twin instance carries the app's name (driver per-app options)"; check grep -q "twin device on .*instance as app 'vrdual-cube'" "$tmp/mirror.log"
    label="mirror: app clears alpha 0, frame file alpha 255"
    check bash -c "for i in \$(seq 100); do a=\$(python3 -I '$VRDUAL_ROOT/tools/frame_hash.py' --alpha /dev/shm/vrdual-$sess-0) && break; sleep 0.1; done; [ \"\$a\" = 255 ]"
    label="mirror: default ipd 64mm"; check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/m1.png' && $M '$tmp/m1.png' --ipd 0.064 --anchor center"
    set_live ipd=0.2
    label="mirror: live ipd 200mm";   check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/m2.png' && $M '$tmp/m2.png' --ipd 0.2 --anchor center"
    set_live ipd=0.064 head_x=0.05 head_yaw=-4
    label="mirror: head offset 50mm right, then turned 4 deg left"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/m3.png' && $M '$tmp/m3.png' --ipd 0.064 --anchor center --head-x 0.05 --head-yaw -4"
    label="record: 1 s SBS mp4 at 30 fps, full and half width (ffprobe)"
    check bash -c "w=\$(identify -format %w '$tmp/m1.png') h=\$(identify -format %h '$tmp/m1.png')
        p() { ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=width,height,nb_read_frames -of csv=p=0 \"\$1\"; }
        '$B/vrdual-compositor' --session $sess --record '$tmp/rec.mp4' --seconds 1 --fps 30 --timeout 20 2>'$tmp/rec.log' | grep -qx '$tmp/rec.mp4' &&
        '$B/vrdual-compositor' --session $sess --record '$tmp/rech.mp4' --seconds 1 --fps 30 --half --timeout 20 2>>'$tmp/rec.log' >/dev/null &&
        [[ \$(p '$tmp/rec.mp4') == \$((w / 2 * 2)),\$((h / 2 * 2)),30 && \$(p '$tmp/rech.mp4') == \$((w / 4 * 2)),\$((h / 2 * 2)),30 ]] &&
        grep -q 'recorded 30 frames' '$tmp/rec.log' || { echo w=\$w h=\$h; p '$tmp/rec.mp4'; p '$tmp/rech.mp4'; cat '$tmp/rec.log'; false; }"
    set_live head_x=0 head_yaw=0
    kill $(jobs -p) 2>/dev/null; wait 2>/dev/null

    # 3b. Mirror with Vulkan 1.4 paths DXVK 3 needs: device addresses (captured on
    # A, replayed on B) and vkMapMemory2. Wrong addresses on B = garbage right eye.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --bda --late-verts 60 --title "selftest bda" >"$tmp/bda.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images' "$tmp/bda.log" && break; sleep 0.1; done
    # Vertices are written at frame 60, long after the first sync: with dirty
    # tracking on, only a scan that sees that write gets them to B (right eye).
    label="mirror bda: addresses replayed, late vertex write reaches B (dirty tracking on), ipd 64mm"
    check bash -c "grep -q 'device addresses replayed' '$tmp/bda.log' && grep -q 'dirty tracking on' '$tmp/bda.log' &&
        '$B/vrdual-compositor' --session $sess --snapshot '$tmp/bda.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
        $M '$tmp/bda.png' --ipd 0.064 --anchor center && ! grep -q STOPPED '$tmp/bda.log' || { cat '$tmp/bda.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    label="mirror: cached write tracking off by default (cached_wp = 0)"
    check bash -c "grep -q 'device addresses replayed' '$tmp/bda.log' && ! grep -q 'cached write tracking on' '$tmp/bda.log'"

    # 3b2. Cached (readback) memory, default: shadowed like the rest. The late
    # vertex write is a pread(2) straight into the mapping (kernel writes: UE3
    # texture streaming; they fail with cached_wp = 1), and every frame the GPU
    # fills a HOST_CACHED buffer the app reads back after the fence (write-back).
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --bda --cached --late-verts 60 --verts-file --readback --title "selftest cached shadow" >"$tmp/cs.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images' "$tmp/cs.log" && break; sleep 0.1; done
    label="mirror cached shadow: pread into the mapping reaches both eyes, GPU fills read back (ipd 64mm)"
    check bash -c "'$B/vrdual-compositor' --session $sess --snapshot '$tmp/cs.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
        $M '$tmp/cs.png' --ipd 0.064 --anchor center && for i in \$(seq 100); do grep -q '^readback: [1-9][0-9]* ok' '$tmp/cs.log' && break; sleep 0.1; done &&
        grep -q '^readback: [1-9][0-9]* ok, 0 bad' '$tmp/cs.log' && ! grep -q 'readback: .* [1-9][0-9]* bad' '$tmp/cs.log' &&
        ! grep -q 'pread into the mapping' '$tmp/cs.log' && ! grep -q STOPPED '$tmp/cs.log' || { cat '$tmp/cs.log'; false; }"
    label="mirror write-back: a storage buffer in readback memory is logged once (shader stores are not copied back)"
    check bash -c "[[ \$(grep -c 'storage buffer in readback memory' '$tmp/cs.log') == 1 ]] || { grep mirror '$tmp/cs.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3b3. 10-bit swapchain (UE4 games pick A2B10G10R10 even with HDR off):
    # exported through a blit to 8-bit, both eyes. Also runs with sparse = 1 (smoke test)
    # and draws from vertex memory exported as an fd on a second VkDevice and
    # imported (the right eye only shows the posts if B shares the import like A does).
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_SPARSE=1 \
        "$B/vrdual-cube" --scene calib --swapchain-format a2b10g10r10 --mem-export-dev2 --title "selftest 10-bit" >"$tmp/tb.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images\|not offered' "$tmp/tb.log" && break; sleep 0.1; done
    if grep -q 'not offered' "$tmp/tb.log"; then
        say "SKIP  10-bit swapchain (the surface offers no A2B10G10R10)"
    else
        label="mirror 10-bit swapchain: exported through a blit to 8-bit, ipd 64mm"
        check bash -c "grep -q 'exported through a blit' '$tmp/tb.log' && '$B/vrdual-compositor' --session $sess --snapshot '$tmp/tb.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
            $M '$tmp/tb.png' --ipd 0.064 --anchor center && ! grep -q STOPPED '$tmp/tb.log' || { cat '$tmp/tb.log'; false; }"
        label="sparse = 1 (VRDUAL_SPARSE): applied, mirror runs"; check grep -q 'mirror_gpu=.* sparse=1' "$tmp/tb.log"
        label="mirror: external_memory_fd visible, an import shares B's twin of the exporter (another VkDevice)"
        check bash -c "grep -q 'draws read the imported copy' '$tmp/tb.log' && grep -q 'import shares B.*exported by another device' '$tmp/tb.log' || { grep -i 'memory\\|STOP' '$tmp/tb.log'; false; }"
    fi
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3c. Cached write tracking (cached_wp = 1): HOST_CACHED mapping protected per block; the late
    # vertex write must fault, be recorded and reach B.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_CACHED_WP=1 \
        "$B/vrdual-cube" --scene calib --bda --cached --late-verts 60 --title "selftest cached wp" >"$tmp/wp.log" 2>&1 &
    for i in $(seq 100); do grep -q 'twin images' "$tmp/wp.log" && break; sleep 0.1; done
    label="mirror cached write tracking: late write faults and reaches B, ipd 64mm"
    check bash -c "grep -q 'cached write tracking on' '$tmp/wp.log' &&
        '$B/vrdual-compositor' --session $sess --snapshot '$tmp/wp.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
        $M '$tmp/wp.png' --ipd 0.064 --anchor center && ! grep -q STOPPED '$tmp/wp.log' || { cat '$tmp/wp.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    else
        say "SKIP  two-GPU checks (need one GPU with a monitor and one without)"
    fi

    # Mirror shadows cover the whole allocation: a new mapping with another
    # range (offset 64, then 0) shows what the memory holds, not zeros.
    if (( two )); then
        rm -f /dev/shm/vrdual-$sess-*
        env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
            "$B/vrdual-cube" --scene calib --remap --title "selftest remap" >"$tmp/rm.log" 2>&1 &
        for i in $(seq 100); do grep -q 'exporting' "$tmp/rm.log" && break; sleep 0.1; done
        label="mirror: re-map with another range keeps the contents (shadow per allocation), ipd 64mm"
        check bash -c "grep -q 'remap: new mapping shows the earlier contents' '$tmp/rm.log' &&
            '$B/vrdual-compositor' --session $sess --snapshot '$tmp/rm.png' --at 60 --timeout 20 >/dev/null 2>&1 &&
            $M '$tmp/rm.png' --ipd 0.064 --anchor center && ! grep -q STOPPED '$tmp/rm.log' || { grep -E 'remap|mirror' '$tmp/rm.log'; false; }"
        kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true
        # vkWaitSemaphores(WAIT_ANY) returns when one semaphore is reached: the
        # write-back must not wait for the other one's unfinished submit (was 1 s).
        label="mirror: vkWaitSemaphores ANY returns at once (no write-back wait for the other semaphore), fill read back"
        check bash -c "out=\$(env VK_ADD_LAYER_PATH='$B' VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
            '$B/vrdual-cube' --scene calib --wait-any --frames 30 --title 'selftest wait-any' 2>&1) &&
            ms=\$(grep -oP 'wait-any: 0 after \K[0-9.]+(?= ms; fill read back)' <<<\"\$out\") && awk -v m=\"\$ms\" 'BEGIN{exit !(m < 100)}' &&
            ! grep -q STOPPED <<<\"\$out\" || { grep -E 'wait-any|mirror' <<<\"\$out\"; false; }"
        # Destroy / Free wrappers drop the handle from the twin map (3000
        # samplers alive at once, then destroyed: was 3022 entries left), so do
        # children freed with their pool (descriptor pool reset / destroy,
        # command pool destroy: was 7527 entries left).
        label="mirror: destroyed objects leave the handle map (3000 samplers, descriptor sets, command buffers churned)"
        check bash -c "out=\$(env VK_ADD_LAYER_PATH='$B' VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
            '$B/vrdual-cube' --scene calib --churn 3000 --frames 30 --title 'selftest churn' 2>&1) &&
            n=\$(grep -oP 'memory syncs, \K[0-9]+(?= handles mapped)' <<<\"\$out\") && (( n < 1000 )) || { grep -E 'mirror' <<<\"\$out\"; false; }"
    fi

    # VRDUAL_KEEP_EXT names whole extensions: keeping present_id2 must not keep
    # present_id (a substring match did).
    label="VRDUAL_KEEP_EXT: whole names only (present_id2 kept, present_id still hidden)"
    check bash -c "x=\$(env VK_ADD_LAYER_PATH='$B' VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=left VRDUAL_GPU=pci:$gh \
        VRDUAL_KEEP_EXT=VK_KHR_external_semaphore_fd,VK_KHR_present_id2 '$B/vrdual-cube' --list-exts 2>/dev/null) &&
        grep -qx VK_KHR_present_id2 <<<\"\$x\" && grep -qx VK_KHR_external_semaphore_fd <<<\"\$x\" && ! grep -qx VK_KHR_present_id <<<\"\$x\" &&
        ! grep -qx VK_EXT_shader_object <<<\"\$x\" || { echo \"\$x\"; false; }"

    # 3c. Two swapchains (wined3d style): the small one is created last and must
    # neither take the frame file nor crash the big one's export.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        "$B/vrdual-cube" --scene calib --extra-window --title "selftest 2 swapchains" >"$tmp/xw.log" 2>&1 &
    local xw=$!
    for i in $(seq 100); do grep -q 'exporting' "$tmp/xw.log" && break; sleep 0.1; done
    label="mirror: 2 swapchains, biggest exported, ipd 64mm"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/xw.png' && $M '$tmp/xw.png' --ipd 0.064 --anchor center &&
        kill -0 $xw && ! grep -q 'exporting 64x48' '$tmp/xw.log' || { cat '$tmp/xw.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3c'. shader_rules: noshift for the test shader (10-digit key prefix) ->
    # both eyes render the same picture.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        VRDUAL_SHADER_RULES="$("$B/spvpatch" --hash "$tmp/glsl.spv" | cut -c1-10):noshift" VRDUAL_SHADER_DUMP="$tmp/rdump" \
        "$B/vrdual-cube" --scene calib --title "selftest shader rules" >"$tmp/sr.log" 2>&1 &
    for i in $(seq 100); do grep -q 'exporting' "$tmp/sr.log" 2>/dev/null && break; sleep 0.1; done
    label="shader_rules noshift: rule logged, ruled shader dumped as KEY.spv (shader_dump), both eyes equal"
    check bash -c "grep -q 'rule noshift' '$tmp/sr.log' || { cat '$tmp/sr.log'; exit 1; }
        k=\$('$B/spvpatch' --hash '$tmp/glsl.spv'); [[ \$('$B/spvpatch' --hash '$tmp/rdump/'\$k.spv) == \$k ]] || { ls '$tmp/rdump'; exit 1; }
        for i in \$(seq 100); do a=\$(python3 -I '$VRDUAL_ROOT/tools/frame_hash.py' /dev/shm/vrdual-$sess-0 2>/dev/null) b=\$(python3 -I '$VRDUAL_ROOT/tools/frame_hash.py' /dev/shm/vrdual-$sess-1 2>/dev/null)
            [[ -n \$a && \${a#* } == \${b#* } ]] && exit 0; sleep 0.1; done; echo \"\$a / \$b\"; false"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3c'f. hunt_fragment: the fragment shader joins the shader list; hunting
    # hide on its key alone discards what it draws on both eyes (mirror: A and
    # B's twin), the vertex shader still runs; off brings the posts back.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_HUNT_FRAGMENT=1 \
        "$B/vrdual-cube" --scene calib --title "selftest hunt fragment" >"$tmp/hfr.log" 2>&1 &
    for i in $(seq 100); do grep -q 'exporting' "$tmp/hfr.log" 2>/dev/null && break; sleep 0.1; done
    local fk; fk=$("$B/spvpatch" --hash "$tmp/frag.spv")
    label="hunt_fragment: fragment key listed, hide on it alone -> both eyes background only"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; '$B/vrdual-ctl' --session $sess shaders | grep -qx $fk &&
        '$B/vrdual-ctl' --session $sess hunt hide ${fk:0:8} ${fk:0:8} >/dev/null && snap '$tmp/hfr.png' &&
        (( \$(convert '$tmp/hfr.png' -unique-colors -format %w info:) <= 2 )) || { '$B/vrdual-ctl' --session $sess shaders; tail -5 '$tmp/hfr.log'; false; }"
    "$B/vrdual-ctl" --session $sess hunt off >/dev/null
    label="hunt_fragment: hunt off, posts back, ipd 64mm"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/hfr2.png' && $M '$tmp/hfr2.png' --ipd 0.064 --anchor center"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true
    # a hide rule on the fragment key, without hunt_fragment: discarded always
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_SHADER_RULES="$fk:hide" \
        "$B/vrdual-cube" --scene calib --title "selftest fragment rule" >"$tmp/hfr3.log" 2>&1 &
    for i in $(seq 100); do grep -q 'exporting' "$tmp/hfr3.log" 2>/dev/null && break; sleep 0.1; done
    label="shader_rules hide on a fragment key: logged as fragment shader, both eyes background only"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; grep -q 'shader $fk: fragment shader' '$tmp/hfr3.log' && snap '$tmp/hfr3.png' &&
        (( \$(convert '$tmp/hfr3.png' -unique-colors -format %w info:) <= 2 )) || { tail -5 '$tmp/hfr3.log'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3c''. hud_depth_scope = rules: without a hud rule the HUD (w == 1) stays
    # at infinity although hud_depth = 1.5; posts unchanged.
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
        VRDUAL_HUD_DEPTH=1.5 VRDUAL_HUD_DEPTH_SCOPE=rules VRDUAL_SHADER_DUMP="$tmp/dump" "$B/vrdual-cube" --scene calib --nopos-vs --title "selftest hud scope" >"$tmp/hs.log" 2>&1 &
    for i in $(seq 100); do grep -q 'exporting' "$tmp/hs.log" 2>/dev/null && break; sleep 0.1; done
    label="hud_depth_scope rules: HUD at infinity, ipd 64mm"
    check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/hs.png' && $M '$tmp/hs.png' --ipd 0.064 --anchor center || { cat '$tmp/hs.log'; false; }"
    label="shader_dump: an unpatched vertex shader (no gl_Position, no vec4) written once as KEY.spv"
    check bash -c "f=\$(ls '$tmp/dump'/*.spv) && [[ \$(wc -w <<<\"\$f\") == 1 ]] && spirv-val --target-env vulkan1.1 \$f &&
        grep -q \"not patched: .*, dumped to \$f\\$\" '$tmp/hs.log' || { grep 'not patched' '$tmp/hs.log'; ls '$tmp/dump'; false; }"
    kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true

    # 3c''''. shader_catalog: the cube VS is known, the nopos VS is new, one
    # catalog key is never seen; summary at exit (--frames).
    rm -f /dev/shm/vrdual-$sess-*
    { echo "# selftest"; echo "# translator Old 1.2.3"; echo "$("$B/spvpatch" --hash "$tmp/glsl.spv")  vs  patched  cube"; echo "0123456789abcdef  vs  gone"; } >"$tmp/cat.tsv"
    label="shader_catalog: unknown shader logged once as new, summary counts seen / new / unseen"
    check bash -c "env VK_ADD_LAYER_PATH='$B' VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both \
            VRDUAL_SHADER_CATALOG='$tmp/cat.tsv' timeout 60 '$B/vrdual-cube' --scene calib --nopos-vs --frames 5 --title 'selftest catalog' >'$tmp/cat.log' 2>&1 &&
        grep -q 'shader_catalog: 2 key(s)' '$tmp/cat.log' &&
        [[ \$(grep -c 'not in catalog' '$tmp/cat.log') == 1 ]] && grep -q 'not in catalog (not patched: no vec4 type)' '$tmp/cat.log' &&
        grep -q 'shader_catalog: 2 shader(s) seen, 1 new, 1 of 2 catalog key(s) unseen' '$tmp/cat.log' || { grep 'catalog' '$tmp/cat.log'; false; }"
    label="shader_catalog: translator logged, a catalog from another translator says so"
    check grep -q 'shader_catalog: translator changed (catalog: Old 1.2.3, now: none): every key may be new' "$tmp/cat.log"
    label="shaders new: log -> catalog lines (once per key), appended to a catalog only if missing, translator line updated"
    check bash -c "d=\$(date +%F); l=\$('$VRDUAL_ROOT/vrdual' shaders new '$tmp/cat.log' 2>/dev/null) &&
        [[ \$(wc -l <<<\"\$l\") == 1 ]] && grep -qP \"^[0-9a-f]{16}  not patched: no vec4 type  new \$d\\$\" <<<\"\$l\" &&
        cp '$tmp/cat.tsv' '$tmp/cat2.tsv' && '$VRDUAL_ROOT/vrdual' shaders new '$tmp/cat.log' '$tmp/cat2.tsv' >/dev/null 2>&1 &&
        [[ -z \$('$VRDUAL_ROOT/vrdual' shaders new '$tmp/cat.log' '$tmp/cat2.tsv' 2>/dev/null) ]] &&
        grep -qxF \"\$l\" '$tmp/cat2.tsv' && [[ \$(grep -c '^# translator' '$tmp/cat2.tsv') == 1 ]] && grep -qx '# translator none' '$tmp/cat2.tsv' &&
        [[ \$(wc -l <'$tmp/cat2.tsv') == 5 ]] || { cat '$tmp/cat2.tsv'; false; }"

    # 3c'''. Tessellation / geometry stages (HairWorks, DX11 terrain): only
    # the last pre-raster stage shifts (the VS before it gets the gate spec
    # constant false); a doubled shift would measure 128 mm.
    local opt
    for opt in --tess --geom "--tess --geom"; do
        rm -f /dev/shm/vrdual-$sess-*
        # shellcheck disable=SC2086
        env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_DEPTH_EXPORT=1 \
            "$B/vrdual-cube" --scene calib $opt --title "selftest stages" >"$tmp/ts.log" 2>&1 &
        for i in $(seq 100); do grep -q 'twin images' "$tmp/ts.log" && break; sleep 0.1; done
        label="mirror ${opt//--/}: last pre-raster stage shifted once, ipd 64mm"
        check bash -c "'$B/vrdual-compositor' --session $sess --snapshot '$tmp/ts.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
            $M '$tmp/ts.png' --ipd 0.064 --anchor center && ! grep -q 'STOPPED\|not patched' '$tmp/ts.log' &&
            grep -q 'depth_export: not in mirror mode yet' '$tmp/ts.log' || { cat '$tmp/ts.log'; false; }"
        kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true
    done

    # 3d. Single-GPU mode: right_gpu = the app's GPU -> alternate-eye rendering
    # on that GPU (no twin device). With --bda the app's own device addresses
    # must keep working (a twin on the same GPU could not replay them).
    for opt in "" --bda; do
        rm -f /dev/shm/vrdual-$sess-*
        env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_DEPTH_EXPORT=1 \
            VRDUAL_RIGHT_GPU=pci:$gd "$B/vrdual-cube" --scene calib $opt --title "selftest one gpu" >"$tmp/one.log" 2>&1 &
        for i in $(seq 100); do grep -q 'exporting' "$tmp/one.log" && break; sleep 0.1; done
        label="single GPU${opt:+ $opt}: alternate eyes on the display GPU, ipd 64mm, left depth plane = the posts"
        check bash -c "$(declare -f snap); B='$B' sess=$sess; grep -q 'alternate-eye rendering on .*$gd' '$tmp/one.log' &&
            grep -q 'one GPU: turn off temporal AA' '$tmp/one.log' &&
            snap '$tmp/one.png' --depth '$tmp/one.pfm' && $M '$tmp/one.png' --ipd 0.064 --anchor center --depth '$tmp/one.pfm' || { cat '$tmp/one.log'; false; }"
        if [[ -z $opt ]]; then  # HUD (w == 1) moved from infinity to 1.5 m
            set_live hud_depth=1.5
            label="hud_depth 1.5m: HUD disparity, posts unchanged"
            check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/hud.png' && $M '$tmp/hud.png' --ipd 0.064 --anchor center --hud-depth 1.5"
            set_live hud=hide
            label="hud hide (screenshots): HUD bar gone in both eyes, posts unchanged"
            check bash -c "$(declare -f snap); B='$B' sess=$sess; snap '$tmp/nohud.png' && $M '$tmp/nohud.png' --ipd 0.064 --anchor center --no-hud"
            set_live hud=show
            # vrdual shot --hud still: HUD at the centre's depth, so a wiggle
            # (aligned at the centre) leaves it in place; hud_depth restored
            label="shot --hud still: HUD bar disparity = the centre's (wiggle dx), hud and hud_depth restored"
            check bash -c "d=\$('$VRDUAL_ROOT/vrdual' shot '$tmp/still.png' --hud still --session $sess 2>'$tmp/still.log' >/dev/null; grep -oE 'hud_depth [0-9.]+ m' '$tmp/still.log' | cut -d' ' -f2) &&
                [[ -n \$d ]] && $M '$tmp/still.png' --ipd 0.064 --anchor center --hud-depth \$d >/dev/null && dx=\$(python3 -I '$VRDUAL_ROOT/tools/wiggle.py' '$tmp/still.png' -) &&
                w=\$(python3 -I -c 'import sys; from PIL import Image; print(Image.open(sys.argv[1]).width // 2)' '$tmp/still.png') &&
                python3 -c 'import sys; d, dx, w = map(float, sys.argv[1:]); h = -0.064 / d * w / 2; sys.exit(abs(h - dx) > 2)' \$d \$dx \$w &&
                l=\$('$B/vrdual-ctl' --session $sess live) && grep -q '^hud_depth 1.5\$' <<<\"\$l\" && grep -q '^hud show\$' <<<\"\$l\" || { echo \"hud_depth \$d dx \$dx\"; cat '$tmp/still.log'; false; }"
            set_live hud_depth=0
        fi
        kill $(jobs -p) 2>/dev/null || true; wait 2>/dev/null || true
    done

    # 3e. auto_noshift: --shadow draws the near post into a depth-only 512x512
    # pass with the main view's vertex shader and logs where its edge lands. Shifted
    # per eye the eyes disagree by ~34 px (left sees it further right); auto_noshift
    # flags the off-screen pass live and they agree. Mirror: A's eye agrees
    # too (hooks in front of the mirror's wrappers), the scene keeps 64 mm.
    edge_after() {  # last "shadow edge" x in LOG after the line matching RE, once 3 are there
        local n; n=$(sed -n "/$2/,\$p" "$1" | grep -c 'shadow edge')
        (( n >= 3 )) && sed -n "/$2/,\$p" "$1" | grep 'shadow edge' | tail -1 | grep -oE '[-0-9]+$'
    }
    local a sp=() xl xr
    for a in 0 1; do
        rm -f /dev/shm/vrdual-$sess-*
        sp=()
        for e in left right; do
            env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=$e VRDUAL_GPU=pci:$gh \
                VRDUAL_AUTO_NOSHIFT=$a VRDUAL_PASS_TRACE=60 "$B/vrdual-cube" --scene calib --shadow --title "selftest shadow $e" >"$tmp/sh$a-$e.log" 2>&1 &
            sp+=($!)
        done
        local re=$([[ $a == 1 ]] && echo 'auto_noshift: off-screen pass' || echo 'exporting')
        xl="" xr=""
        for i in $(seq 300); do
            xl=$(edge_after "$tmp/sh$a-left.log" "$re") && xr=$(edge_after "$tmp/sh$a-right.log" "$re") && break; sleep 0.1
        done
        if [[ $a == 0 ]]; then
            label="shadow pass shifted per eye without auto_noshift (edges ~34 px apart)"
            check bash -c "[[ -n '$xl' && -n '$xr' ]] && (( $xl - $xr >= 30 && $xl - $xr <= 38 )) || { echo 'left $xl right $xr'; false; }"
        else
            label="auto_noshift: off-screen pass flagged live, shared shader not shifted there: eyes agree, half way between"
            check bash -c "[[ -n '$xl' && '$xl' == '$xr' ]] && (( $xl >= 118 && $xl <= 122 )) &&
                grep -q 'auto_noshift: off-screen pass 512x512 not shifted (main view 960x720)' '$tmp/sh1-left.log' || { echo 'left $xl right $xr'; false; }"
            label="pass_trace: one frame's passes (shadow pass off-screen, main view shifted) and binds logged"
            check bash -c "grep -q 'pass_trace: present 60 (tracing from here)' '$tmp/sh1-left.log' && grep -q 'pass_trace: present 61 (end)' '$tmp/sh1-left.log' &&
                grep -qE 'pass_trace: cb .* depth only 512x512 target [0-9a-f]+ -> off-screen \(not shifted\)' '$tmp/sh1-left.log' && grep -qE 'pass_trace: cb .* colour 960x720 target [0-9a-f]+ -> shifted' '$tmp/sh1-left.log' &&
                grep -qE 'pass_trace: cb .*   bind [0-9a-f]{8}' '$tmp/sh1-left.log' || { grep pass_trace '$tmp/sh1-left.log' | head; false; }"
        fi
        kill "${sp[@]}" 2>/dev/null; wait "${sp[@]}" 2>/dev/null
    done
    rm -f /dev/shm/vrdual-$sess-*
    env VK_ADD_LAYER_PATH="$B" VK_INSTANCE_LAYERS=VK_LAYER_VRDUAL_stereo VRDUAL_SESSION=$sess VRDUAL_EYE=both VRDUAL_AUTO_NOSHIFT=1 \
        "$B/vrdual-cube" --scene calib --shadow --title "selftest shadow mirror" >"$tmp/shm.log" 2>&1 &
    sp=($!)
    for i in $(seq 300); do xl=$(edge_after "$tmp/shm.log" 'auto_noshift: off-screen pass') && break; sleep 0.1; done
    label="auto_noshift in the mirror: A's shadow pass unshifted, ipd 64mm"
    check bash -c "[[ -n '$xl' ]] && (( $xl >= 118 && $xl <= 122 )) && '$B/vrdual-compositor' --session $sess --snapshot '$tmp/shm.png' --at 80 --timeout 20 >/dev/null 2>&1 &&
        $M '$tmp/shm.png' --ipd 0.064 --anchor center && ! grep -q STOPPED '$tmp/shm.log' || { echo 'A edge $xl'; tail -5 '$tmp/shm.log'; false; }"
    # The cube copies its shadow row into the top image rows: B's own shadow map.
    label="auto_noshift in the mirror: B's shadow pass unshifted too (shadow row in the image, both eyes at A's edge)"
    check bash -c "e=\$(python3 -c '
import sys
from PIL import Image
im = Image.open(sys.argv[1]).convert(\"RGB\"); W = im.width // 2
print(*(next((x for x in range(512) if im.getpixel((x0 + x, 1))[1] > 32), -1) for x0 in (0, W)))
' '$tmp/shm.png') && read l r <<<\"\$e\" && (( l == $xl && r == $xl )) || { echo \"image L R \$e, A edge $xl\"; false; }"
    kill "${sp[@]}" 2>/dev/null; wait "${sp[@]}" 2>/dev/null

    # 4. Mirror mode under Zink (OpenGL 2.1-era app), 64- and 32-bit; eyes must differ.
    # --shadow + auto_noshift: the FBO "shadow map" (shown unshifted, top left)
    # must match in both eyes, i.e. B's twin honours the pass flag under Zink.
    # vblank_mode=0 everywhere: an occluded GL window under FIFO gets ~1 frame/s
    # and never reaches the 30 presents auto_noshift needs (cf. MAILBOX in testapp).
    local gl
    for gl in "$B/vrdual-gltest" "$B/lib32/vrdual-gltest"; do
        [[ -x $gl ]] || { say "SKIP  mirror zink $(basename "$(dirname "$gl")") (make lib32)"; continue; }
        rm -f /dev/shm/vrdual-$sess-*
